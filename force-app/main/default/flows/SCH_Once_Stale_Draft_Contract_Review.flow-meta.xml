    <decisions>
        <name>Dec_Any_Drafts</name>
        <label>Dec Any Drafts</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Create_Summary_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Drafts</defaultConnectorLabel>
        <rules>
            <name>Has_Drafts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Contracts</targetReference>
            </connector>
            <label>Has Drafts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Start_Passed</name>
        <label>Dec Start Passed</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Asg_Pending</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Start Ahead</defaultConnectorLabel>
        <rules>
            <name>Start_Passed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContract.StartDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Review_Task</targetReference>
            </connector>
            <label>Start Passed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Review_Tasks</name>
        <label>Dec Has Review Tasks</label>
        <locationX>314</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Create_Summary_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPastStart</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Review_Tasks</targetReference>
            </connector>
            <label>Has Tasks</label>
        </rules>
    </decisions>
    <description>One-time batch (no object): finds Draft contracts older than 60 days, bulk-creates review Tasks for those whose start date has already passed, counts the rest as pending, and stores/e-mails a summary.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff60</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 60</expression>
    </formulas>
    <formulas>
        <name>fxDue</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <interviewLabel>SCH Once Stale Draft Contract Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Once Stale Draft Contract Review</label>
    <loops>
        <name>Loop_Contracts</name>
        <label>Loop Contracts</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <assignNextValueToReference>varContract</assignNextValueToReference>
        <collectionReference>Get_Draft_Contracts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Start_Passed</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Has_Review_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
