    <collectionProcessors>
        <name>Sort_By_End_Date</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort By End Date</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Assets</collectionReference>
        <connector>
            <targetReference>Loop_Assets</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>UsageEndDate</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Dec_Account_Found</name>
        <label>Dec Account Found</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Asg_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Assets</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Warranty_State</name>
        <label>Dec Warranty State</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Asg_Active</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Active</defaultConnectorLabel>
        <rules>
            <name>Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAsset.UsageEndDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Expired</targetReference>
            </connector>
            <label>Expired</label>
        </rules>
        <rules>
            <name>Expiring</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAsset.UsageEndDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fxHorizon</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Expiring</targetReference>
            </connector>
            <label>Expiring</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Create_Task</name>
        <label>Dec Create Task</label>
        <locationX>314</locationX>
        <locationY>1022</locationY>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Task_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inCreateTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>outExpiringCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Review_Task</targetReference>
            </connector>
            <label>Task Requested</label>
        </rules>
    </decisions>
    <description>Classifies an Account's Assets by UsageEndDate (expired / expiring within N days / active), returns counts and the next expiry date, and optionally creates a warranty review Task for the Account owner.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxHorizon</name>
        <dataType>Date</dataType>
        <expression>TODAY() + BLANKVALUE({!inDaysAhead}, 30)</expression>
    </formulas>
    <interviewLabel>AUT Asset Warranty Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Asset Warranty Check</label>
    <loops>
        <name>Loop_Assets</name>
        <label>Loop Assets</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignNextValueToReference>varAsset</assignNextValueToReference>
        <collectionReference>Get_Assets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Warranty_State</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Create_Task</targetReference>
        </noMoreValuesConnector>
    </loops>
