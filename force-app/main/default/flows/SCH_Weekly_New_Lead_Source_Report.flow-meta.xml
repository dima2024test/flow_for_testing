        </connector>
    </assignments>
    <assignments>
        <name>Asg_Partner</name>
        <label>Asg Partner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPartner</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Leads</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Other</name>
        <label>Asg Other</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOther</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Leads</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Call_Task</name>
        <label>Asg Call Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>[Flow Demo] Call hot new lead</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.WhoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varHotLead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varHotLead.CreatedById</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxTomorrow</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colNewTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varNewTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHot</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Hot_Leads</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Hot_Uncontacted</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Hot Uncontacted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Hot_Uncontacted</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_New_Leads</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Hot_Uncontacted.Rating</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Hot</stringValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Hot_Uncontacted.Status</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Open - Not Contacted</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Hot_Leads</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Any_Leads</name>
        <label>Dec Any Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Report_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No New Leads</defaultConnectorLabel>
        <rules>
            <name>Has_Leads</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Leads</targetReference>
            </connector>
            <label>Has Leads</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Source</name>
        <label>Dec Source</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Other</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Source</defaultConnectorLabel>
        <rules>
            <name>Web</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLead.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Web</targetReference>
            </connector>
            <label>Web</label>
        </rules>
        <rules>
            <name>Phone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLead.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Phone Inquiry</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Phone</targetReference>
            </connector>
            <label>Phone</label>
        </rules>
        <rules>
            <name>Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLead.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner Referral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Partner</targetReference>
            </connector>
            <label>Partner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Hot</name>
        <label>Dec Has Hot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Report_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Hot Leads</defaultConnectorLabel>
        <rules>
            <name>Has_Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHot</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Call_Tasks</targetReference>
            </connector>
            <label>Has Hot</label>
        </rules>
    </decisions>
    <description>Weekly batch (no object): counts unconverted leads created in the last 7 days per lead source, bulk-creates call Tasks for hot, not-yet-contacted leads, stores the report as a Task and e-mails it.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff7</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <name>fxTomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <interviewLabel>SCH Weekly New Lead Source Report {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly New Lead Source Report</label>
    <loops>
        <name>Loop_Leads</name>
        <label>Loop Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varLead</assignNextValueToReference>
        <collectionReference>Get_New_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Source</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Filter_Hot_Uncontacted</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Hot_Leads</name>
        <label>Loop Hot Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varHotLead</assignNextValueToReference>
        <collectionReference>Filter_Hot_Uncontacted</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Call_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Has_Hot</targetReference>
        </noMoreValuesConnector>
    </loops>
