    <textTemplates>
        <name>ttAlert</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Status: {!$Record.StatusType}
Subject: {!$Record.Subject}
Service: {!$Record.ServiceName} (job {!$Record.ServiceJobId})
Component: {!$Record.ComponentName} / {!$Record.SubComponentName}
