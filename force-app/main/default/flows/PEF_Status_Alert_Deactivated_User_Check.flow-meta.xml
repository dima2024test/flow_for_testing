    <description>Subscribes to PlatformStatusAlertEvent: checks the affected user - active users get a Task to check their integration; for inactive or unknown users it totals the open Opportunities they still own and opens an admin Case (High when pipeline is orphaned).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxOppAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varOpp.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxUserLabel</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Username}, BLANKVALUE({!$Record.UserId}, 'unknown user'))</expression>
    </formulas>
    <formulas>
        <name>fxCaseSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Platform alert for inactive user ' &amp; {!fxUserLabel}, 255)</expression>
    </formulas>
    <interviewLabel>PEF Status Alert Deactivated User Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Status Alert Deactivated User Check</label>
