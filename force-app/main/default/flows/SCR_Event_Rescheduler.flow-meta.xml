    <decisions>
        <name>Dec_Valid_Time</name>
        <label>Dec Valid Time</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Overlapping_Events</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valid</defaultConnectorLabel>
        <rules>
            <name>Invalid_Time</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>New_Duration</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>New_Start</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Invalid</targetReference>
            </connector>
            <label>Invalid Time</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Conflict</name>
        <label>Dec Conflict</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Event</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Free</defaultConnectorLabel>
        <rules>
            <name>Has_Conflict</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varConflicts</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Conflict</targetReference>
            </connector>
            <label>Has Conflict</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Proceed</name>
        <label>Dec Proceed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Scr_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Proceed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Conflict_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proceed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Update_Event</targetReference>
            </connector>
            <label>Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Notify</name>
        <label>Dec Notify</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Log_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Notify</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Attendee_Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Attendee</targetReference>
            </connector>
            <label>Notify</label>
        </rules>
    </decisions>
    <description>Pick one of my upcoming Events, choose a new start/duration and reason, detect calendar conflicts, update the Event, optionally e-mail the attendee and log a completed Task.</description>
    <dynamicChoiceSets>
        <name>EventChoices</name>
        <dataType>String</dataType>
        <displayField>Subject</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartDateTime</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsAllDayEvent</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <limit>100</limit>
        <object>Event</object>
        <sortField>StartDateTime</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxNewEnd</name>
        <dataType>DateTime</dataType>
        <expression>{!New_Start} + ({!New_Duration} / 1440)</expression>
    </formulas>
    <formulas>
        <name>fxConflictLine</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!varOverlap.Subject}, '(no subject)') &amp; ' @ ' &amp; TEXT({!varOverlap.StartDateTime}) &amp; '; '</expression>
    </formulas>
    <formulas>
        <name>fxDescription</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!Get_Event.Description}, '') &amp; ' | Rescheduled (' &amp; {!Reschedule_Reason} &amp; '): ' &amp; BLANKVALUE({!Reschedule_Comment}, ''), 32000)</expression>
    </formulas>
    <formulas>
        <name>fxEmailSubject</name>
        <dataType>String</dataType>
        <expression>'Rescheduled: ' &amp; BLANKVALUE({!Get_Event.Subject}, 'meeting')</expression>
    </formulas>
    <interviewLabel>SCR Event Rescheduler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Event Rescheduler</label>
    <loops>
