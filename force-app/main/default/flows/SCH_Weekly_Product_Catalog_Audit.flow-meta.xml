            </conditions>
            <connector>
                <targetReference>Asg_Missing_Family</targetReference>
            </connector>
            <label>Missing Family</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Gaps_Found</name>
        <label>Dec Gaps Found</label>
        <locationX>578</locationX>
        <locationY>854</locationY>
        <defaultConnectorLabel>Catalog Clean</defaultConnectorLabel>
        <rules>
            <name>Gaps</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varMissingCode</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varMissingFamily</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Audit_Email</targetReference>
            </connector>
            <label>Gaps</label>
        </rules>
    </decisions>
    <description>Weekly batch (no object): checks all active Products for missing product code or family, counts products added in the last 30 days, stores an audit Task (High if gaps found) and e-mails the report.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff30</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <formulas>
        <name>fxGapLine</name>
        <dataType>String</dataType>
        <expression>LEFT({!varProduct.Name}, 60) &amp; '; '</expression>
    </formulas>
    <formulas>
        <name>fxPriority</name>
        <dataType>String</dataType>
        <expression>IF({!varMissingCode} + {!varMissingFamily} &gt; 0, 'High', 'Low')</expression>
    </formulas>
    <interviewLabel>SCH Weekly Product Catalog Audit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Product Catalog Audit</label>
