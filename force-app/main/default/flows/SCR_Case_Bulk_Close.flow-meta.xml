        <label>Asg Low Cases</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <assignmentItems>
            <assignToReference>colSource</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Filter_Low_Priority</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_All_Cases</name>
        <label>Asg All Cases</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <assignmentItems>
            <assignToReference>colSource</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Open_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Close_Case</name>
        <label>Asg Close Case</label>
        <locationX>50</locationX>
        <locationY>1526</locationY>
        <assignmentItems>
            <assignToReference>varCase.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxComment</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCase.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCase.Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Close_Reason</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colToClose</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCase</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClosed</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Low_Priority</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Low Priority</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <assignNextValueToReference>currentItem_Filter_Low_Priority</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Open_Cases</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Low_Priority.Priority</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Low</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Low_Cases</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Has_Cases</name>
        <label>Dec Has Cases</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Scr_No_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Close_Options</targetReference>
            </connector>
            <label>Has Cases</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Scope</name>
        <label>Dec Scope</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Asg_All_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Cases</defaultConnectorLabel>
        <rules>
            <name>Low_Only_Scope</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Low_Only</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Low_Priority</targetReference>
            </connector>
            <label>Low Only Scope</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Anything</name>
        <label>Dec Anything</label>
        <locationX>314</locationX>
        <locationY>1526</locationY>
        <defaultConnector>
            <targetReference>Scr_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing</defaultConnectorLabel>
        <rules>
            <name>Has_Cases_To_Close</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClosed</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Cases</targetReference>
            </connector>
            <label>Has Cases To Close</label>
        </rules>
    </decisions>
    <description>Pick an Account, review its open Cases, choose a reason and comment, optionally only Low priority ones; closes them in one bulk update and writes an audit Task.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ReasonChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Reason</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxComment</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!varCase.Description}, '') &amp; ' || ' &amp; 'Closed in bulk: ' &amp; BLANKVALUE({!Close_Comment}, ''), 31000)</expression>
    </formulas>
    <interviewLabel>SCR Case Bulk Close {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Case Bulk Close</label>
    <loops>
        <name>Loop_Cases</name>
        <label>Loop Cases</label>
        <locationX>314</locationX>
        <locationY>1358</locationY>
        <assignNextValueToReference>varCase</assignNextValueToReference>
        <collectionReference>colSource</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Close_Case</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Anything</targetReference>
        </noMoreValuesConnector>
    </loops>
