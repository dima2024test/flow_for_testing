    <decisions>
        <name>Dec_Status_Type</name>
        <label>Dec Status Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Info</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Informational</defaultConnectorLabel>
        <rules>
            <name>Failure</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Fail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Critical</targetReference>
            </connector>
            <label>Failure</label>
        </rules>
        <rules>
            <name>Warning</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Warn</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Warning</targetReference>
            </connector>
            <label>Warning</label>
        </rules>
    </decisions>
