    <description>Subscribes to BatchApexErrorEvent: correlates the event's RequestId / AsyncApexJobId with '[Flow Error]' log Tasks of the last hour (collection filter on Description) and, when related logs exist, creates one correlation Task for an admin and e-mails it.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLastHour</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - (1/24)</expression>
    </formulas>
    <formulas>
        <name>fxLogLine</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!varLog.CreatedDate}) &amp; ' ' &amp; {!varLog.Subject}, 300)</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Correlated batch failure, request ' &amp; {!$Record.RequestId}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Batch_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'BatchApexCorrelation' &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Batch_Error_Request_Correlator' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
    <interviewLabel>PEF Batch Error Request Correlator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Batch Error Request Correlator</label>
