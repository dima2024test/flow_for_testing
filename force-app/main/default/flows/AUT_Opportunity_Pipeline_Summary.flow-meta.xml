<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Deal_Count</name>
        <label>Asg Deal Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outDealCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Opportunities</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Has_Deals</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Accumulate</name>
        <label>Asg Accumulate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outTotalPipeline</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outWeightedPipeline</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxWeighted</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Top_Deal</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Top_Deal</name>
        <label>Asg Top Deal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outTopDealName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varOpp.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Late_Stage</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Late_Stage</name>
        <label>Asg Late Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outLateStageCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_No_Deals</name>
        <label>Asg No Deals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outTotalPipeline</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outTopDealName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>none</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <collectionProcessors>
        <name>Sort_By_Amount</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort By Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>Amount</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Dec_Has_Deals</name>
        <label>Dec Has Deals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_No_Deals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Deals</defaultConnectorLabel>
        <rules>
            <name>Has_Deals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outDealCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sort_By_Amount</targetReference>
            </connector>
            <label>Has Deals</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Top_Deal</name>
        <label>Dec Top Deal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Dec_Late_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not First</defaultConnectorLabel>
        <rules>
            <name>First_Item</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outTopDealName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Top_Deal</targetReference>
            </connector>
            <label>First Item</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Late_Stage</name>
        <label>Dec Late Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Early Stage</defaultConnectorLabel>
        <rules>
            <name>Late_Stage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.Probability</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>70.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Late_Stage</targetReference>
            </connector>
            <label>Late Stage</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Create_Task</name>
        <label>Dec Create Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Task_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inCreateTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Summary_Task</targetReference>
            </connector>
            <label>Task Requested</label>
        </rules>
    </decisions>
    <description>Returns open pipeline, weighted pipeline, deal count and the largest open deal for an Account; optionally writes a summary Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varOpp.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxWeighted</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varOpp.Amount}, 0) * BLANKVALUE({!varOpp.Probability}, 0) / 100</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>AUT Opportunity Pipeline Summary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Opportunity Pipeline Summary</label>
    <loops>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varOpp</assignNextValueToReference>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Accumulate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Create_Task</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Summary_Task</name>
        <label>Create Summary Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>[Flow Demo] Pipeline summary</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>inAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ttSummary</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Open_Opportunities</name>
        <label>Get Open Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Deal_Count</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Opportunities</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Log_Fault</name>
        <label>Log Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>AUT_Log_Flow_Error</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>AUT_Opportunity_Pipeline_Summary</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inSeverity</name>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>inAccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttSummary</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Open pipeline: {!outTotalPipeline}
Weighted: {!outWeightedPipeline}
Deals: {!outDealCount} (late stage: {!outLateStageCount})
Largest deal: {!outTopDealName}</text>
    </textTemplates>
