        <locationX>50</locationX>
        <locationY>686</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Orphan_Tasks</collectionReference>
        <connector>
            <targetReference>Loop_Tasks</targetReference>
        </connector>
        <limit>50</limit>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>CreatedDate</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Dec_Any_Orphans</name>
        <label>Dec Any Orphans</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>None Found</defaultConnectorLabel>
        <rules>
            <name>Has_Orphans</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sort_Newest_First</targetReference>
            </connector>
            <label>Has Orphans</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Contact_Has_Account</name>
        <label>Dec Contact Has Account</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Asg_Skip</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Linkable</defaultConnectorLabel>
        <rules>
            <name>Linkable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Who_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Who_Contact.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varTask.WhoId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Who_Contact.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Link</targetReference>
            </connector>
            <label>Linkable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Links</name>
        <label>Dec Has Links</label>
        <locationX>314</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Create_Summary_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing Linked</defaultConnectorLabel>
        <rules>
            <name>Has_Links</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLinked</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tasks</targetReference>
            </connector>
            <label>Has Links</label>
        </rules>
    </decisions>
    <description>Daily batch (no object): takes up to 50 newest open Tasks that have a Who but no What, looks up the Contact and links the task to the contact's Account in one bulk update; leads/contacts without account are skipped; summary is e-mailed.</description>
    <environments>Default</environments>
    <interviewLabel>SCH Daily Orphan Task Account Linker {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Daily Orphan Task Account Linker</label>
    <loops>
        <name>Loop_Tasks</name>
        <label>Loop Tasks</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignNextValueToReference>varTask</assignNextValueToReference>
        <collectionReference>Get_Orphan_Tasks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Who_Contact</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Has_Links</targetReference>
        </noMoreValuesConnector>
    </loops>
