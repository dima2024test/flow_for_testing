    <decisions>
        <name>Dec_Copy_Related</name>
        <label>Dec Copy Related</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Sub_Pipeline</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Copy</defaultConnectorLabel>
        <rules>
            <name>Copy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Copy_Related</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lines</targetReference>
            </connector>
            <label>Copy</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Lines</name>
        <label>Dec Any Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Roles</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Lines</defaultConnectorLabel>
        <rules>
            <name>Has_Lines</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLineCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Lines</targetReference>
            </connector>
            <label>Has Lines</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Roles</name>
        <label>Dec Any Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
