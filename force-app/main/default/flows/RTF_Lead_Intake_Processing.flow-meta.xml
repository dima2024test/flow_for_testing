    <decisions>
        <name>Dec_Lead_Source</name>
        <label>Dec Lead Source</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Standard_SLA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Source</defaultConnectorLabel>
        <rules>
            <name>Web_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Fast_Followup_Task</targetReference>
            </connector>
            <label>Web Lead</label>
        </rules>
        <rules>
            <name>Partner_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner Referral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Partner_Task</targetReference>
            </connector>
            <label>Partner Lead</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Email</name>
        <label>Dec Has Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Email_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Duplicate_Leads</targetReference>
            </connector>
            <label>Email Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Duplicate_Found</name>
        <label>Dec Duplicate Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Unique</defaultConnectorLabel>
        <rules>
            <name>Duplicate</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varDuplicateLeads</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varMatchingContacts</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Duplicate_Task</targetReference>
            </connector>
            <label>Duplicate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Still_Untouched</name>
        <label>Dec Still Untouched</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Being Worked</defaultConnectorLabel>
        <rules>
            <name>Untouched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Current.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead_Current.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open - Not Contacted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Rating</targetReference>
            </connector>
            <label>Untouched</label>
        </rules>
    </decisions>
    <description>After-save on Lead create. Immediate: source-based follow-up Task. Async path: duplicate check against Leads and Contacts with alert. Scheduled path +3 days: cools down untouched leads.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSlaDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!varSlaDays}</expression>
    </formulas>
    <formulas>
        <name>fxTomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
