<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Audit_Email</name>
        <label>Send Audit Email</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] Large opportunity amount change</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttAudit</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Count_Item</name>
        <label>Asg Count Item</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignmentItems>
            <assignToReference>varLineItemCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Line_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_What_Changed</name>
        <label>Dec What Changed</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Nothing Relevant</defaultConnectorLabel>
        <rules>
            <name>Amount_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Amount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dec_Large_Change</targetReference>
            </connector>
            <label>Amount Changed</label>
        </rules>
        <rules>
            <name>Probability_Dropped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Probability</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Probability</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Probability_Task</targetReference>
            </connector>
            <label>Probability Dropped</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Large_Change</name>
        <label>Dec Large Change</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Small Change</defaultConnectorLabel>
        <rules>
            <name>Large_Change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxChangePct</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Line_Items</targetReference>
            </connector>
            <label>Large Change</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Account</name>
        <label>Dec Has Account</label>
        <locationX>314</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Pipeline_Summary</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <description>After-save on open Opportunity update: compares Amount and Probability with the prior values ($Record__Prior), audits large changes with a Task + e-mail and flags probability drops. Async path refreshes the pipeline summary.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxPriorAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record__Prior.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxNewAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxChangePct</name>
        <dataType>Number</dataType>
        <expression>IF({!fxPriorAmount} = 0, 100, ABS({!fxNewAmount} - {!fxPriorAmount}) / {!fxPriorAmount} * 100)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>RTF Opportunity Amount Change Audit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Opportunity Amount Change Audit</label>
    <loops>
        <name>Loop_Line_Items</name>
        <label>Loop Line Items</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <collectionReference>Get_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Count_Item</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Audit_Task</targetReference>
        </noMoreValuesConnector>
    </loops>
