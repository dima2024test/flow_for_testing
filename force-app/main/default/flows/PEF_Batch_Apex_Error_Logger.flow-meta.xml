    <description>Subscribes to BatchApexErrorEvent: classifies severity by phase, finds an active System Administrator, creates a Task with full exception details, e-mails on critical phases and records the error via the shared logger subflow.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Batch Apex error: ' &amp; BLANKVALUE({!$Record.ExceptionType}, 'Unknown') &amp; ' [' &amp; BLANKVALUE({!$Record.Phase}, '?') &amp; ']', 255)</expression>
    </formulas>
