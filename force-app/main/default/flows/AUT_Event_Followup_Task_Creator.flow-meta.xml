    <description>Creates a single follow-up Task for an Event (same Who/What), skipping it when an open follow-up already exists; owner is the Event's active assignee or its creator. WhatId is left blank when the Event's WhoId is a Lead.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Follow-up: ' &amp; {!Get_Event.Subject}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + BLANKVALUE({!inDueInDays}, 2)</expression>
    </formulas>
    <formulas>
        <name>fxSince</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <formulas>
        <name>fxWhoIsLead</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!Get_Event.WhoId}, 3) = '00Q'</expression>
    </formulas>
