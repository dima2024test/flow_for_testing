    <decisions>
        <name>Dec_Event_Found</name>
        <label>Dec Event Found</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Asg_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Event_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Event</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Event.EndDateTime</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_Until_Event_End</targetReference>
            </connector>
            <label>Event Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Event_Still_Exists</name>
        <label>Dec Event Still Exists</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Asg_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Deleted</defaultConnectorLabel>
        <rules>
            <name>Still_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Event_After_End</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Create_Followup</targetReference>
            </connector>
            <label>Still Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Open</name>
        <label>Dec Any Open</label>
        <locationX>50</locationX>
        <locationY>1694</locationY>
        <defaultConnector>
            <targetReference>Asg_Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Done</defaultConnectorLabel>
        <rules>
            <name>Followups_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Open_Followups</targetReference>
            </connector>
            <label>Followups Open</label>
        </rules>
    </decisions>
    <description>Waits until 1 hour after an Event ends, creates the follow-up Task via AUT_Event_Followup_Task_Creator, waits 3 days and escalates still-open follow-ups (priority High + e-mail).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Follow-up: ' &amp; {!Get_Event.Subject}, 255)</expression>
    </formulas>
    <interviewLabel>AUT Event Followup With Wait {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Event Followup With Wait</label>
    <loops>
        <name>Loop_Open_Followups</name>
        <label>Loop Open Followups</label>
        <locationX>50</locationX>
        <locationY>1862</locationY>
        <assignNextValueToReference>varTask</assignNextValueToReference>
        <collectionReference>Get_Open_Followups</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Raise_Priority</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Followups</targetReference>
        </noMoreValuesConnector>
    </loops>
