    <decisions>
        <name>Dec_Expiry_Window</name>
        <label>Dec Expiry Window</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Not Yet</defaultConnectorLabel>
        <rules>
            <name>Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Expired_Task</targetReference>
            </connector>
            <label>Expired</label>
        </rules>
        <rules>
            <name>Expiring_Soon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fxIn60Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Renewal</targetReference>
            </connector>
            <label>Expiring Soon</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Renewal_Exists</name>
        <label>Dec Renewal Exists</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create Renewal</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Renewal</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Usable_Contact</name>
        <label>Dec Usable Contact</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Loop_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Usable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Contacts.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Contact</targetReference>
            </connector>
            <label>Usable</label>
        </rules>
    </decisions>
    <description>Weekly, per activated Contract: contracts ending within 60 days get a renewal Opportunity (de-duplicated) and a Task; the first account contact with an e-mail is attached; expired contracts get a clean-up Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxIn60Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 60</expression>
    </formulas>
    <formulas>
        <name>fxRenewalName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Renewal - ' &amp; {!$Record.ContractNumber}, 120)</expression>
    </formulas>
    <interviewLabel>SCH Weekly Contract Expiry Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Contract Expiry Check</label>
    <loops>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <collectionReference>Get_Account_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
