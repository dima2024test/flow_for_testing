    <decisions>
        <name>Dec_User_Found</name>
        <label>Dec User Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Unknown_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unknown</defaultConnectorLabel>
        <rules>
            <name>User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Interview_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Interview_User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_User_Context</targetReference>
            </connector>
            <label>User Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Error_Type</name>
        <label>Dec Error Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Category_Other</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Data_Operation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ElementType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Record</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Category_Data</targetReference>
            </connector>
            <label>Data Operation</label>
        </rules>
        <rules>
            <name>Action_Call</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ElementType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Action</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Category_Action</targetReference>
            </connector>
            <label>Action Call</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Threshold</name>
        <label>Dec Threshold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Sub_Log_Flow_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below Threshold</defaultConnectorLabel>
        <rules>
            <name>Threshold_Reached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRecentCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Threshold_Email</targetReference>
            </connector>
            <label>Threshold Reached</label>
        </rules>
    </decisions>
    <description>Subscribes to FlowExecutionErrorEvent (screen flow errors): categorises the failing element, resolves the user, counts similar errors in the last 24h and alerts when the threshold is reached; always logs via the shared logger.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLast24h</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 1</expression>
    </formulas>
    <formulas>
        <name>fxMessage</name>
        <dataType>String</dataType>
        <expression>LEFT('[' &amp; {!varCategory} &amp; '] ' &amp; {!$Record.ElementApiName} &amp; ': ' &amp; BLANKVALUE({!$Record.ErrorMessage}, 'n/a'), 3000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Flow_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; BLANKVALUE({!$Record.FlowApiName}, '') &amp; ' (' &amp; BLANKVALUE({!varSeverity}, '') &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Flow_Error_Monitor' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
    <interviewLabel>PEF Flow Error Monitor {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Flow Error Monitor</label>
