            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Existing_Reminder</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Reason_Stale</name>
        <label>Asg Reason Stale</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>varReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>no activity for 30 days</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Existing_Reminder</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Primary_Contact</name>
        <label>Asg Primary Contact</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <assignmentItems>
            <assignToReference>varPrimaryContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Contact_Roles.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contact_Roles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Skip</name>
        <label>Asg Skip</label>
        <locationX>314</locationX>
        <locationY>854</locationY>
        <assignmentItems>
            <assignToReference>varReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>skipped</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Dec_Deal_Health</name>
        <label>Dec Deal Health</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Healthy</defaultConnectorLabel>
        <rules>
            <name>Past_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Reason_Past_Due</targetReference>
            </connector>
            <label>Past Due</label>
        </rules>
        <rules>
            <name>Stale</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastModifiedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxStaleCutoff</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Reason_Stale</targetReference>
            </connector>
            <label>Stale</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Reminder_Exists</name>
        <label>Dec Reminder Exists</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Get_Contact_Roles</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Reminder</defaultConnectorLabel>
        <rules>
            <name>Already_Reminded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Reminder</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Skip</targetReference>
            </connector>
            <label>Already Reminded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Is_Primary</name>
        <label>Dec Is Primary</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Loop_Contact_Roles</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Primary</defaultConnectorLabel>
        <rules>
            <name>Primary</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Contact_Roles.IsPrimary</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Primary_Contact</targetReference>
            </connector>
            <label>Primary</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Large_Deal</name>
        <label>Dec Large Deal</label>
        <locationX>314</locationX>
        <locationY>1358</locationY>
        <defaultConnectorLabel>Regular Deal</defaultConnectorLabel>
        <rules>
            <name>Large_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Next_Step</targetReference>
            </connector>
            <label>Large Deal</label>
        </rules>
    </decisions>
    <description>Daily, per open Opportunity: flags past-due or stale (30+ days untouched) deals, de-duplicates reminders, finds the primary contact and creates a reminder Task; large deals get NextStep updated.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxStaleCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>'[Flow Demo] Stale deal: ' &amp; {!varReason}</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel>SCH Daily Stale Opportunity Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Daily Stale Opportunity Review</label>
    <loops>
        <name>Loop_Contact_Roles</name>
        <label>Loop Contact Roles</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <collectionReference>Get_Contact_Roles</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Is_Primary</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Reminder_Task</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Reminder_Task</name>
        <label>Create Reminder Task</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <connector>
            <targetReference>Dec_Large_Deal</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fxSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>varPrimaryContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fxDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Reminder</name>
        <label>Get Existing Reminder</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_Reminder_Exists</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>[Flow Demo] Stale deal</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
