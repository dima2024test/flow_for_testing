<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Existing_Count</name>
        <label>Asg Existing Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExistingRoles</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Existing_Roles</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Roles_Exist</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Role</name>
        <label>Asg Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varRole.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRole.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContact.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRole.Role</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Decision Maker</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colRoles</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varRole</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRoleCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Senior_Contacts</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Senior_Contacts</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Senior Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Senior_Contacts</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Account_Contacts</collectionReference>
        <conditionLogic>(1 OR 2 OR 3) AND 4</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Senior_Contacts.Title</leftValueReference>
            <operator>Contains</operator>
            <rightValue>
                <stringValue>Director</stringValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Senior_Contacts.Title</leftValueReference>
            <operator>Contains</operator>
            <rightValue>
                <stringValue>Chief</stringValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Senior_Contacts.Title</leftValueReference>
            <operator>Contains</operator>
            <rightValue>
                <stringValue>VP</stringValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Senior_Contacts.Email</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Senior_Contacts</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Roles_Exist</name>
        <label>Dec Roles Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Roles</defaultConnectorLabel>
        <rules>
            <name>Has_Roles</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingRoles</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>Has Roles</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Roles</name>
        <label>Dec Any Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Role_Review_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Senior Contacts</defaultConnectorLabel>
        <rules>
            <name>Has_Senior_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRoleCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Contact_Roles</targetReference>
            </connector>
            <label>Has Senior Contacts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Many_Deals</name>
        <label>Dec Many Deals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Normal Load</defaultConnectorLabel>
        <rules>
            <name>Many_Open_Deals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDealCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Capacity_Task</targetReference>
            </connector>
            <label>Many Open Deals</label>
        </rules>
    </decisions>
    <description>After-save on Opportunity create (with Account, no roles yet): adds Decision Maker contact roles for senior contacts of the account (collection filter on Title, bulk create) or a Task to identify them. Async path: pipeline summary subflow and a capacity Task when the account has many open deals.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <interviewLabel>RTF Opportunity Create Contact Roles {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Opportunity Create Contact Roles</label>
    <loops>
        <name>Loop_Senior_Contacts</name>
        <label>Loop Senior Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varContact</assignNextValueToReference>
        <collectionReference>Filter_Senior_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Role</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Any_Roles</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Contact_Roles</name>
        <label>Create Contact Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputReference>colRoles</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Role_Review_Task</name>
        <label>Create Role Review Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>[Flow Demo] Identify decision makers for new deal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fxDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Capacity_Task</name>
        <label>Create Capacity Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>[Flow Demo] Account has 5+ open deals - check capacity</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ttPipeline</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fxDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Roles</name>
        <label>Get Existing Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Existing_Count</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Account_Contacts</name>
        <label>Get Account Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Filter_Senior_Contacts</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Roles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Sub_Pipeline_Summary</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Sub_Pipeline_Summary</name>
        <label>Sub Pipeline Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Dec_Many_Deals</targetReference>
        </connector>
        <flowName>AUT_Opportunity_Pipeline_Summary</flowName>
        <inputAssignments>
            <name>inAccountId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inCreateTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varPipeline</assignToReference>
            <name>outTotalPipeline</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varDealCount</assignToReference>
            <name>outDealCount</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varLateStage</assignToReference>
            <name>outLateStageCount</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Log_Fault</name>
        <label>Log Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>AUT_Log_Flow_Error</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>RTF_Opportunity_Create_Contact_Roles</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inSeverity</name>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttPipeline</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>New opportunity {!$Record.Name} was added. Account pipeline: {!varPipeline} across {!varDealCount} open deal(s), {!varLateStage} in late stage. Please check the team has capacity.</text>
    </textTemplates>
    <variables>
        <name>varContact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>varRole</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityContactRole</objectType>
    </variables>
    <variables>
        <name>colRoles</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityContactRole</objectType>
    </variables>
    <variables>
        <name>varExistingRoles</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varRoleCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varPipeline</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varDealCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varLateStage</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>currentItem_Filter_Senior_Contacts</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
