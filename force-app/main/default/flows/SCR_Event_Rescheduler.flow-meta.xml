    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Conflict</name>
        <label>Asg Conflict</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varConflicts</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varConflictList</assignToReference>
            <operator>Add</operator>
