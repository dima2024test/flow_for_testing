            </conditions>
            <connector>
                <targetReference>Create_Nurture_Task</targetReference>
            </connector>
            <label>Low Score</label>
        </rules>
    </decisions>
    <description>After-save on Account create: segment-specific setup (Task / starter Opportunity), duplicate-name check with alert, contact normalization subflow; scheduled path +1 day runs health scoring subflow.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxOppName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!$Record.Name} &amp; ' - First Deal', 120)</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel>RTF Account After Create Setup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Account After Create Setup</label>
