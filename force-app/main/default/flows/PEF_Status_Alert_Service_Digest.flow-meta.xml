    <description>Subscribes to PlatformStatusAlertEvent: maintains one daily digest Task per service (append or create), counts open digests for the day and escalates to an active admin when 3+ services report alerts.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxToday</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Service alerts ' &amp; TEXT(TODAY()) &amp; ': ' &amp; {!varServiceKey}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxLine</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.EventDate}) &amp; ' | ' &amp; BLANKVALUE({!$Record.StatusType}, '?') &amp; ' | ' &amp; BLANKVALUE({!$Record.ComponentName}, '') &amp; ' | ' &amp; BLANKVALUE({!$Record.Subject}, '')</expression>
    </formulas>
    <formulas>
        <name>fxAppended</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!Get_Digest_Task.Description}, '') &amp; ' || ' &amp; {!fxLine}, 31000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Alert_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PlatformStatusAlert' &amp; ' (' &amp; 'Warning' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Status_Alert_Service_Digest' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
