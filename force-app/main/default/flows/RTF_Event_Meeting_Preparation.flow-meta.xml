    <decisions>
        <name>Dec_Prep_Open</name>
        <label>Dec Prep Open</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Prepared</defaultConnectorLabel>
        <rules>
            <name>Prep_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenPrepCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Prep Open</label>
        </rules>
    </decisions>
    <description>After-save on Event create: for meetings with a Contact counts other meetings with that contact within a week and runs the activity snapshot subflow, then creates a preparation Task. Scheduled path 1 day before StartDateTime e-mails the organizer if the preparation Task is still open.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxWhoPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.WhoId}, 3)</expression>
    </formulas>
    <formulas>
        <name>fxWeekBefore</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.StartDateTime} - 7</expression>
    </formulas>
    <formulas>
        <name>fxWeekAfter</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.StartDateTime} + 7</expression>
    </formulas>
    <formulas>
        <name>fxPrepDue</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.StartDateTime}) - 1</expression>
    </formulas>
    <interviewLabel>RTF Event Meeting Preparation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Event Meeting Preparation</label>
