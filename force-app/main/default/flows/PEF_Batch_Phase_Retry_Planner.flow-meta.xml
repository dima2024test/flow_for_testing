    <decisions>
        <name>Dec_Phase</name>
        <label>Dec Phase</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnector>
            <targetReference>Asg_Execute_Hint</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Execute Phase</defaultConnectorLabel>
        <rules>
            <name>Start_Phase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Phase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>START</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Start_Hint</targetReference>
            </connector>
            <label>Start Phase</label>
        </rules>
        <rules>
            <name>Finish_Phase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Phase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FINISH</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Finish_Hint</targetReference>
            </connector>
            <label>Finish Phase</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Retry_Budget</name>
        <label>Dec Retry Budget</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Create_Retry_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Retry Allowed</defaultConnectorLabel>
        <rules>
            <name>Budget_Exhausted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAttempts</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Escalation_Case</targetReference>
            </connector>
            <label>Budget Exhausted</label>
        </rules>
    </decisions>
    <description>Subscribes to BatchApexErrorEvent: picks a phase-specific retry strategy (START / EXECUTE / FINISH), counts earlier retry attempts for the same async job and creates a dated retry Task for an active admin, or an escalated Case once 3 attempts failed.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Batch retry: job ' &amp; BLANKVALUE({!$Record.AsyncApexJobId}, 'unknown'), 255)</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!varDueOffset}</expression>
    </formulas>
    <formulas>
        <name>fxPriorLine</name>
        <dataType>String</dataType>
        <expression>TEXT({!varPrior.CreatedDate}) &amp; ' (' &amp; TEXT({!varPrior.Status}) &amp; ')'</expression>
    </formulas>
    <interviewLabel>PEF Batch Phase Retry Planner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Batch Phase Retry Planner</label>
    <loops>
        <name>Loop_Prior_Attempts</name>
        <label>Loop Prior Attempts</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <assignNextValueToReference>varPrior</assignNextValueToReference>
        <collectionReference>Get_Prior_Attempts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Collect_Attempt</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Retry_Budget</targetReference>
        </noMoreValuesConnector>
    </loops>
