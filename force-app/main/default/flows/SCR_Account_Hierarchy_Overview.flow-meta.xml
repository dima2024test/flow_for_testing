<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Child_Totals</name>
        <label>Asg Child Totals</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <assignmentItems>
            <assignToReference>varChildCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildRevenue</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxRevenue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxChildLine</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>; </stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Children</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Has_Children</name>
        <label>Dec Has Children</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Scr_No_Children</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standalone</defaultConnectorLabel>
        <rules>
            <name>Has_Children</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varChildCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Overview</targetReference>
            </connector>
            <label>Has Children</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Create_Review</name>
        <label>Dec Create Review</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Scr_Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Review_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Create_Review</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Review_Task</targetReference>
            </connector>
            <label>Review Requested</label>
        </rules>
    </decisions>
    <description>Pick an Account: lists its child accounts with combined annual revenue, shows the parent's pipeline from subflow and optionally creates a hierarchy review Task.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxRevenue</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varChild.AnnualRevenue}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxChildLine</name>
        <dataType>String</dataType>
        <expression>{!varChild.Name} &amp; ' (' &amp; BLANKVALUE(TEXT({!varChild.Type}), 'n/a') &amp; ')'</expression>
    </formulas>
    <interviewLabel>SCR Account Hierarchy Overview {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Account Hierarchy Overview</label>
    <loops>
        <name>Loop_Children</name>
        <label>Loop Children</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignNextValueToReference>varChild</assignNextValueToReference>
        <collectionReference>Get_Child_Accounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Child_Totals</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Sub_Pipeline</targetReference>
        </noMoreValuesConnector>
    </loops>
