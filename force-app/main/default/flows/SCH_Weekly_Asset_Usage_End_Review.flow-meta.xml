<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Case_Count</name>
        <label>Asg Case Count</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignmentItems>
            <assignToReference>varOpenCases</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Asset_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_High_Case</name>
        <label>Asg High Case</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <assignmentItems>
            <assignToReference>varHighCases</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Usage_Window</name>
        <label>Dec Usage Window</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Not Yet</defaultConnectorLabel>
        <rules>
            <name>Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UsageEndDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Expired_Task</targetReference>
            </connector>
            <label>Expired</label>
        </rules>
        <rules>
            <name>Ending_Soon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UsageEndDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fxIn30Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Renewal_Task</targetReference>
            </connector>
            <label>Ending Soon</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Task_Exists</name>
        <label>Dec Task Exists</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Get_Asset_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Renewal_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_High_Case</name>
        <label>Dec High Case</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Loop_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not High</defaultConnectorLabel>
        <rules>
            <name>High</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCase.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_High_Case</targetReference>
            </connector>
            <label>High</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Account</name>
        <label>Dec Has Account</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Create_Renewal_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Account_Health</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <description>Weekly, per installed/registered Asset with a usage end date: expired assets get a clean-up Task; assets ending within 30 days get a de-duplicated renewal Task whose priority depends on open High cases on the asset and the account health.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxIn30Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>fxPriority</name>
        <dataType>String</dataType>
        <expression>IF({!varHighCases} &gt; 0, 'High', 'Normal')</expression>
    </formulas>
    <interviewLabel>SCH Weekly Asset Usage End Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Asset Usage End Review</label>
    <loops>
        <name>Loop_Cases</name>
        <label>Loop Cases</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <assignNextValueToReference>varCase</assignNextValueToReference>
        <collectionReference>Get_Asset_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_High_Case</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Has_Account</targetReference>
        </noMoreValuesConnector>
    </loops>
