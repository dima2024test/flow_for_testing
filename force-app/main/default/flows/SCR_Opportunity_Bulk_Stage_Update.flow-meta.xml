<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Opp_Count</name>
        <label>Asg Opp Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOppCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Opportunities</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Has_Opportunities</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Apply_Changes</name>
        <label>Asg Apply Changes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpp.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>New_Stage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOpp.CloseDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>New_Close_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colOppsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varOpp</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChanged</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Has_Opportunities</name>
        <label>Dec Has Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Scr_No_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Opportunities</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOppCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Choose_Stage</targetReference>
            </connector>
            <label>Has Opportunities</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Stage_Differs</name>
        <label>Dec Stage Differs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unchanged</defaultConnectorLabel>
        <rules>
            <name>Needs_Change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>New_Stage</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Apply_Changes</targetReference>
            </connector>
            <label>Needs Change</label>
        </rules>
        <rules>
            <name>Date_Differs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.CloseDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>New_Close_Date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Asg_Apply_Changes</targetReference>
            </connector>
            <label>Date Differs</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Anything_To_Update</name>
        <label>Dec Anything To Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Scr_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing Changed</defaultConnectorLabel>
        <rules>
            <name>Has_Changes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varChanged</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunities</targetReference>
            </connector>
            <label>Has Changes</label>
        </rules>
    </decisions>
    <description>Pick an Account, then move all of its open Opportunities to a chosen stage/close date in one bulk update with an audit Task.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>StageChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>StageName</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxDefaultClose</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <interviewLabel>SCR Opportunity Bulk Stage Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Opportunity Bulk Stage Update</label>
    <loops>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varOpp</assignNextValueToReference>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Stage_Differs</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Anything_To_Update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Audit_Task</name>
        <label>Create Audit Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Scr_Result</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Sub_Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>[Flow Demo] Bulk opportunity stage update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ttAudit</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Open_Opportunities</name>
        <label>Get Open Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Opp_Count</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sub_Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <sortField>CloseDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunities</name>
        <label>Update Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Audit_Task</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Sub_Log_Fault</targetReference>
        </faultConnector>
        <inputReference>colOppsToUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Scr_Select_Account</name>
        <label>Scr Select Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Open_Opportunities</targetReference>
        </connector>
        <fields>
            <name>Account_Picker</name>
            <choiceReferences>AccountChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Account</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Scr_Choose_Stage</name>
        <label>Scr Choose Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
        <fields>
            <name>Stage_Intro</name>
            <fieldText>&lt;p&gt;{!varOppCount} open opportunity(ies) found.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>New_Stage</name>
            <choiceReferences>StageChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>New stage</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>New_Close_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>fxDefaultClose</elementReference>
            </defaultValue>
            <fieldText>New close date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Scr_Result</name>
        <label>Scr Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!varChanged}&lt;/b&gt; of {!varOppCount} opportunity(ies) updated.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Scr_No_Opportunities</name>
        <label>Scr No Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Opps_Text</name>
            <fieldText>&lt;p&gt;This account has no open opportunities.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Scr_Error</name>
        <label>Scr Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Something went wrong.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The error has been logged for an administrator.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Scr_Select_Account</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Sub_Log_Fault</name>
        <label>Sub Log Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Scr_Error</targetReference>
        </connector>
        <flowName>AUT_Log_Flow_Error</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>SCR_Opportunity_Bulk_Stage_Update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inSeverity</name>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttAudit</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Bulk stage update by {!$User.Username}: {!varChanged} opportunity(ies) moved to {!New_Stage}, close date {!New_Close_Date}.</text>
    </textTemplates>
    <variables>
        <name>varOpp</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
    <variables>
        <name>colOppsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
    <variables>
        <name>varOppCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varChanged</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
