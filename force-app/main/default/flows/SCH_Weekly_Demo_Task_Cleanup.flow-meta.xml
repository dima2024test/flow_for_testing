    <description>Weekly housekeeping limited to records created by these demo flows: deletes completed '[Flow Demo]' tasks and '[Flow Error]' logs older than 90 days, raises priority of overdue demo tasks, writes a summary Task and e-mail.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff90</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 90</expression>
    </formulas>
    <interviewLabel>SCH Weekly Demo Task Cleanup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Demo Task Cleanup</label>
