        <label>Asg Append Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDates</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxHitDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varDates</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>; </stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Hits</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Sort_Newest</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort Newest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Recent_Logs</collectionReference>
        <connector>
            <targetReference>Filter_Same_Element</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>CreatedDate</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <collectionProcessors>
        <name>Filter_Same_Element</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Same Element</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Same_Element</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Recent_Logs</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Same_Element.Description</leftValueReference>
            <operator>Contains</operator>
            <rightValue>
                <elementReference>$Record.ElementApiName</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Hits</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Hotspot</name>
        <label>Dec Hotspot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Sub_Log_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Yet</defaultConnectorLabel>
        <rules>
            <name>Hotspot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHits</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Hits</targetReference>
            </connector>
            <label>Hotspot</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Hotspot_Exists</name>
        <label>Dec Hotspot Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Hotspot_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New Hotspot</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Hotspot</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Log_Error</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <description>Subscribes to FlowExecutionErrorEvent: looks at '[Flow Error]' logs of the same flow in the last 7 days, filters those for the same element, sorts newest first and opens one de-duplicated hotspot Task + e-mail when 3+ repeats are found.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxHitDate</name>
        <dataType>String</dataType>
        <expression>TEXT({!varHit.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>fxLast7Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Error hotspot: ' &amp; {!$Record.FlowApiName} &amp; ' / ' &amp; BLANKVALUE({!$Record.ElementApiName}, '?'), 255)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; BLANKVALUE({!$Record.FlowApiName}, '') &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Flow_Error_Hotspot_Detector' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
    <interviewLabel>PEF Flow Error Hotspot Detector {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Flow Error Hotspot Detector</label>
    <loops>
        <name>Loop_Hits</name>
        <label>Loop Hits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varHit</assignNextValueToReference>
        <collectionReference>Filter_Same_Element</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Append_Date</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Existing_Hotspot</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
