        </defaultConnector>
        <defaultConnectorLabel>No Roles</defaultConnectorLabel>
        <rules>
            <name>Has_Roles</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRoleCount</leftValueReference>
