        <conditions>
            <leftValueReference>currentItem_Filter_Likely.ContactId</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Get_Case.ContactId</elementReference>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Likely.Subject</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Get_Case.Subject</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Likely_Count</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Has_Account</name>
