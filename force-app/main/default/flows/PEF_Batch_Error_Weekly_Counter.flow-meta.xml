            </conditions>
            <connector>
                <targetReference>Send_Threshold_Email</targetReference>
            </connector>
            <label>Threshold Reached</label>
        </rules>
    </decisions>
    <description>Subscribes to BatchApexErrorEvent: keeps one counter Task per week and exception type (count in CallDurationInSeconds), deletes counter Tasks older than 8 weeks when a new week starts and e-mails an admin when a type reaches 25 errors in a week.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxWeekStart</name>
        <dataType>Date</dataType>
        <expression>TODAY() - MOD(WEEKDAY(TODAY()) + 5, 7)</expression>
    </formulas>
    <formulas>
        <name>fxWeekEnd</name>
        <dataType>Date</dataType>
        <expression>{!fxWeekStart} + 6</expression>
    </formulas>
    <formulas>
        <name>fxCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 56</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Batch errors week of ' &amp; TEXT({!fxWeekStart}) &amp; ': ' &amp; BLANKVALUE({!$Record.ExceptionType}, 'Unknown'), 255)</expression>
    </formulas>
    <formulas>
        <name>fxNextCount</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Week_Counter.CallDurationInSeconds}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxLine</name>
        <dataType>String</dataType>
        <expression>TEXT(NOW()) &amp; ' [' &amp; BLANKVALUE({!$Record.Phase}, '?') &amp; '] ' &amp; LEFT(BLANKVALUE({!$Record.Message}, ''), 200)</expression>
    </formulas>
    <formulas>
        <name>fxAppended</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!Get_Week_Counter.Description}, '') &amp; ' || ' &amp; {!fxLine}, 31000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Batch_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'BatchApexWeekly' &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Batch_Error_Weekly_Counter' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
