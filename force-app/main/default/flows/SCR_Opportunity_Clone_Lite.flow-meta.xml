    <description>Clone an Opportunity with a new name/stage/close date/amount and optionally copy its product lines and contact roles (bulk creates), then show the account's refreshed pipeline.</description>
    <dynamicChoiceSets>
        <name>OpportunityChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>100</limit>
        <object>Opportunity</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>StageChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>StageName</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxDefaultName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!Get_Opportunity.Name} &amp; ' (Copy)', 120)</expression>
    </formulas>
    <formulas>
        <name>fxCloneName</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!New_Name}, '[Flow Demo] '), {!New_Name}, LEFT('[Flow Demo] ' &amp; {!New_Name}, 120))</expression>
    </formulas>
    <formulas>
        <name>fxDefaultClose</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <interviewLabel>SCR Opportunity Clone Lite {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Opportunity Clone Lite</label>
    <loops>
        <name>Loop_Lines</name>
        <label>Loop Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varLine</assignNextValueToReference>
        <collectionReference>Get_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
