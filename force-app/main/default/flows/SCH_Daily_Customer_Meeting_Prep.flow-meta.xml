    <description>Daily batch (no object): loads Events with a Who starting within 24 hours (soonest 30), skips those already prepared (one Get of recent prep Tasks + collection filter), bulk-creates prep Tasks, then takes an activity snapshot of the soonest meeting's contact and e-mails a warning if that contact has overdue tasks.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fxIn24h</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 1</expression>
    </formulas>
    <formulas>
        <name>fxRecentCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 2</expression>
    </formulas>
    <formulas>
        <name>fxPrepSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Meeting prep: ' &amp; {!varEvent.Subject}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxPrepDescription</name>
        <dataType>String</dataType>
        <expression>'Meeting starts ' &amp; TEXT({!varEvent.StartDateTime}) &amp; '. Review open cases and tasks of the attendee.'</expression>
    </formulas>
    <formulas>
        <name>fxSoonestIsContact</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!varSoonestWhoId}, 3) = '003'</expression>
    </formulas>
