    <description>Waits until 30 days before a Contract's end date, opens a renewal Opportunity (if none), waits 14 days and escalates with a Task and e-mail when the renewal is still open.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxRenewalAlarm</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!Get_Contract.EndDate}) - 30</expression>
    </formulas>
    <formulas>
        <name>fxNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fxRenewalName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Renewal - ' &amp; {!Get_Contract.ContractNumber}, 120)</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_Contract.EndDate}</expression>
    </formulas>
    <interviewLabel>AUT Contract Renewal With Wait {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Contract Renewal With Wait</label>
