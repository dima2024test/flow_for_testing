    <decisions>
        <name>Dec_Account_Found</name>
        <label>Dec Account Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunities</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Opp_Status</name>
        <label>Dec Opp Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Lost</defaultConnectorLabel>
        <rules>
            <name>Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.IsWon</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Won</targetReference>
            </connector>
            <label>Won</label>
        </rules>
        <rules>
            <name>Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Open</targetReference>
            </connector>
            <label>Open</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Rating</name>
        <label>Dec Rating</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Cold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cold</defaultConnectorLabel>
        <rules>
            <name>Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>70.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Hot</targetReference>
            </connector>
            <label>Hot</label>
        </rules>
        <rules>
            <name>Warm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>40.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Warm</targetReference>
            </connector>
            <label>Warm</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Rating_Changed</name>
        <label>Dec Rating Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Unchanged</defaultConnectorLabel>
        <rules>
            <name>Rating_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Rating</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>outRating</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Rating</targetReference>
            </connector>
            <label>Rating Changed</label>
        </rules>
    </decisions>
    <description>Calculates a 0-100 health score for an Account from won/open Opportunities and open Cases and writes Hot/Warm/Cold to Account.Rating.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxOppAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varOpp.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxScore</name>
        <dataType>Number</dataType>
        <expression>MIN(100, MAX(0, 25 + {!varWonCount} * 10 + IF({!varOpenPipeline} &gt; 100000, 30, IF({!varOpenPipeline} &gt; 0, 15, 0)) + IF({!varWonAmount} &gt; 250000, 30, IF({!varWonAmount} &gt; 0, 15, 0)) - {!varOpenCases} * 5))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>AUT Account Health Calculator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Account Health Calculator</label>
    <loops>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varOpp</assignNextValueToReference>
        <collectionReference>Get_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Opp_Status</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Cases</targetReference>
        </noMoreValuesConnector>
    </loops>
