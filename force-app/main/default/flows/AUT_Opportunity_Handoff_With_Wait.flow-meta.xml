<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Reminder_Email</name>
        <label>Send Reminder Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Asg_Reminded</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_New_Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] Open handoff intros</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttReminder</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Build_Intro_Task</name>
        <label>Asg Build Intro Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxIntroSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.WhoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varRole.ContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inNewOwnerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxDueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colNewTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varNewTask</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Roles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Open_Count</name>
        <label>Asg Open Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpenCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Intro_Tasks</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Any_Open</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Reminded</name>
        <label>Asg Reminded</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>REMINDED</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Asg_Completed</name>
        <label>Asg Completed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>COMPLETED</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Asg_Skipped</name>
        <label>Asg Skipped</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SKIPPED</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Dec_Closed_Won</name>
        <label>Dec Closed Won</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Won</defaultConnectorLabel>
        <rules>
            <name>Is_Closed_Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.IsWon</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_New_Owner</targetReference>
            </connector>
            <label>Is Closed Won</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Owner_Valid</name>
        <label>Dec Owner Valid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Asg_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Owner</defaultConnectorLabel>
        <rules>
            <name>Owner_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Owner</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Data_Quality</targetReference>
            </connector>
            <label>Owner Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Open</name>
        <label>Dec Any Open</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Completed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Done</defaultConnectorLabel>
        <rules>
            <name>Intros_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Intros Open</label>
        </rules>
    </decisions>
    <description>Team-less handoff of a Closed Won Opportunity to an account manager: runs the Account data-quality report, waits 1 day, creates an intro Task per contact role (bulk insert), waits 7 days and reminds the new owner about open intros.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fxIntroSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Handoff intro: ' &amp; {!Get_Opportunity.Name}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 3</expression>
    </formulas>
    <interviewLabel>AUT Opportunity Handoff With Wait {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Opportunity Handoff With Wait</label>
    <loops>
        <name>Loop_Roles</name>
        <label>Loop Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varRole</assignNextValueToReference>
        <collectionReference>Get_Contact_Roles</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Build_Intro_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Intro_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Intro_Tasks</name>
        <label>Create Intro Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Wait_7_Days</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputReference>colNewTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_Closed_Won</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Owner</name>
        <label>Get New Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_Owner_Valid</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inNewOwnerId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact_Roles</name>
        <label>Get Contact Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Roles</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Intro_Tasks</name>
        <label>Get Open Intro Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Open_Count</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fxIntroSubject</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Sub_Data_Quality</name>
        <label>Sub Data Quality</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Wait_1_Day</targetReference>
        </connector>
        <flowName>AUT_Account_Data_Quality_Report</flowName>
        <inputAssignments>
            <name>inAccountId</name>
            <value>
                <elementReference>Get_Opportunity.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inCreateTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varGrade</assignToReference>
            <name>outQualityGrade</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Log_Fault</name>
        <label>Log Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>AUT_Log_Flow_Error</flowName>
        <inputAssignments>
            <name>inFlowName</name>
            <value>
                <stringValue>AUT_Opportunity_Handoff_With_Wait</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inSeverity</name>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>inOpportunityId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inOwnerId</name>
            <value>
                <elementReference>inNewOwnerId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttReminder</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>You took over {!Get_Opportunity.Name} one week ago. {!varOpenCount} intro task(s) are still open.
Account data quality grade: {!varGrade}</text>
    </textTemplates>
    <variables>
        <name>inOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inNewOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outResult</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varGrade</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOpenCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varRole</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityContactRole</objectType>
    </variables>
    <variables>
        <name>varNewTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
