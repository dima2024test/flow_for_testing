        </defaultConnector>
        <defaultConnectorLabel>Empty Catalog</defaultConnectorLabel>
        <rules>
            <name>Has_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varActive</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
