    <decisions>
        <name>Dec_Case_Age</name>
        <label>Dec Case Age</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Within SLA</defaultConnectorLabel>
        <rules>
            <name>Over_72h</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxAge72</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Escalated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Escalated</targetReference>
            </connector>
            <label>Over 72h</label>
        </rules>
        <rules>
            <name>Over_24h_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxAge24</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Owner_User</targetReference>
            </connector>
            <label>Over 24h New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Owner_Is_User</name>
        <label>Dec Owner Is User</label>
        <locationX>314</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Asg_Owner_Creator</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Queue or Inactive</defaultConnectorLabel>
        <rules>
            <name>Is_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Owner_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Owner_User</targetReference>
            </connector>
            <label>Is User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Task_Exists</name>
        <label>Dec Task Exists</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Create_SLA_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_SLA_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Exists</label>
        </rules>
    </decisions>
    <description>Daily, per open High/Medium Case: New cases older than 24h get an SLA Task (de-duplicated) for the owning user; cases older than 72h are set to Escalated and e-mailed.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxAge24</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 1</expression>
    </formulas>
    <formulas>
        <name>fxAge72</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 3</expression>
    </formulas>
