        </rules>
    </decisions>
    <decisions>
        <name>Dec_Past_Due</name>
        <label>Dec Past Due</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Loop_All_Deals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>On Track</defaultConnectorLabel>
        <rules>
            <name>Past_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpp.CloseDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Past_Due</targetReference>
            </connector>
            <label>Past Due</label>
        </rules>
    </decisions>
    <description>Weekly batch (no object): totals all open Opportunities, counts deals closing within 30 days and past due, lists the top 10 deals by amount, stores the snapshot as a Task and e-mails it.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxIn30Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>fxAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varOpp.Amount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxTopLine</name>
        <dataType>String</dataType>
        <expression>LEFT({!varTop.Name}, 60) &amp; ': ' &amp; TEXT(BLANKVALUE({!varTop.Amount}, 0))</expression>
    </formulas>
    <interviewLabel>SCH Weekly Pipeline Snapshot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Pipeline Snapshot</label>
    <loops>
