        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnectorLabel>Clean</defaultConnectorLabel>
        <rules>
            <name>Duplicates_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outDuplicateCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Flag_Duplicates</targetReference>
            </connector>
            <label>Duplicates Found</label>
        </rules>
    </decisions>
    <description>Finds potential duplicates of an Account by exact Name and by Phone, returns the count and a readable list of matches.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNameEntry</name>
        <dataType>String</dataType>
        <expression>{!varNameMatch.Name} &amp; ' [name, ' &amp; BLANKVALUE({!varNameMatch.BillingCity}, '-') &amp; ']; '</expression>
    </formulas>
    <formulas>
        <name>fxPhoneEntry</name>
        <dataType>String</dataType>
        <expression>{!varPhoneMatch.Name} &amp; ' [phone, ' &amp; BLANKVALUE({!varPhoneMatch.BillingCity}, '-') &amp; ']; '</expression>
    </formulas>
