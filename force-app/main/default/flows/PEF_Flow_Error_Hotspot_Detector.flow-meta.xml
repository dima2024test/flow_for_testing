        <label>Asg Hits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHits</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Filter_Same_Element</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Hotspot</targetReference>
        </connector>
    </assignments>
    <assignments>
