<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Previous_Rating</name>
        <label>Asg Previous Rating</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPreviousRating</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Rating</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sub_Calculate_Health</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Old_Case_Count</name>
        <label>Asg Old Case Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOldCaseCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Filter_Old_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Too_Many_Old_Cases</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Old_Cases</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Old Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Old_Cases</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Open_Cases</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Old_Cases.CreatedDate</leftValueReference>
            <operator>LessThan</operator>
            <rightValue>
                <elementReference>fxCaseCutoff</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Old_Case_Count</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Rating_Shift</name>
        <label>Dec Rating Shift</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Downgraded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPreviousRating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varNewRating</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Risk_Task</targetReference>
            </connector>
            <label>Downgraded</label>
        </rules>
        <rules>
            <name>Upgraded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNewRating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varPreviousRating</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Upsell</targetReference>
            </connector>
            <label>Upgraded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Upsell_Exists</name>
        <label>Dec Upsell Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Upsell_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Yet</defaultConnectorLabel>
        <rules>
            <name>Upsell_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Upsell</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Cases</targetReference>
            </connector>
            <label>Upsell Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Too_Many_Old_Cases</name>
        <label>Dec Too Many Old Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Too_Many</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOldCaseCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case_Review_Task</targetReference>
            </connector>
            <label>Too Many</label>
        </rules>
    </decisions>
    <description>Weekly, per typed Account: recalculates health via subflow, reacts to rating downgrades (risk Task) and upgrades (de-duplicated upsell Opportunity), and flags accounts with 3+ open cases older than 14 days.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCaseCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 14</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 60</expression>
    </formulas>
    <formulas>
        <name>fxUpsellName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Upsell - ' &amp; {!$Record.Name}, 120)</expression>
    </formulas>
    <interviewLabel>SCH Weekly Account Health Batch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Account Health Batch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
