            </connector>
            <label>Has Likely</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Review_Action</name>
        <label>Dec Review Action</label>
        <locationX>50</locationX>
        <locationY>1694</locationY>
        <defaultConnector>
            <targetReference>Create_Review_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Keep Both</defaultConnectorLabel>
        <rules>
            <name>Close_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Review_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Close</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Close_Duplicate</targetReference>
            </connector>
            <label>Close Duplicate</label>
        </rules>
        <rules>
            <name>Link_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Review_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Link</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Link_Duplicate</targetReference>
            </connector>
            <label>Link Duplicate</label>
        </rules>
    </decisions>
    <description>Pick an open Case, find likely duplicates on the same Account (same contact or same subject) with a collection filter, then close one as duplicate or link it as a child case (no real merge) and log a review Task.</description>
    <dynamicChoiceSets>
        <name>CaseChoices</name>
        <dataType>String</dataType>
        <displayField>CaseNumber</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <limit>200</limit>
        <object>Case</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
