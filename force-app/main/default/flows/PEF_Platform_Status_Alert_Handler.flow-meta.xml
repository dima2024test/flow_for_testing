    <description>Subscribes to PlatformStatusAlertEvent: classifies severity, routes a Task to the affected user (or an active admin), e-mails on failures and logs via the shared logger.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Platform alert: ' &amp; BLANKVALUE({!$Record.Subject}, BLANKVALUE({!$Record.ComponentName}, 'unknown')), 255)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Alert_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Platform_Status_Alert_Handler' &amp; ' (' &amp; BLANKVALUE({!varSeverity}, '') &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Platform_Status_Alert_Handler' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
