    <description>Daily, per Contact with a birthdate: on the birthday, checks (via loop) that no greeting Task was created in the last 300 days, takes an activity snapshot and creates either a greeting Task or a 'resolve open issues first' Task, then e-mails the owner.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxIsBirthday</name>
        <dataType>Boolean</dataType>
        <expression>AND(MONTH({!$Record.Birthdate}) = MONTH(TODAY()), DAY({!$Record.Birthdate}) = DAY(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>fxCutoff300</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 300</expression>
    </formulas>
    <interviewLabel>SCH Daily Contact Birthday Outreach {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Daily Contact Birthday Outreach</label>
    <loops>
        <name>Loop_Greetings</name>
        <label>Loop Greetings</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignNextValueToReference>varTask</assignNextValueToReference>
        <collectionReference>Get_Previous_Greetings</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Recent_Greeting</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Already_Greeted</targetReference>
        </noMoreValuesConnector>
    </loops>
