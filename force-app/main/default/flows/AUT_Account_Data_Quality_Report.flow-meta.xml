    <collectionProcessors>
        <name>Filter_No_Email</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter No Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_No_Email</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Contacts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_No_Email.Email</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Contacts_No_Email</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Account_Found</name>
        <label>Dec Account Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Duplicate_Check</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Grade</name>
        <label>Dec Grade</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Grade_C</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Grade C</defaultConnectorLabel>
        <rules>
            <name>Grade_A</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outIssueCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Grade_A</targetReference>
            </connector>
            <label>Grade A</label>
        </rules>
        <rules>
            <name>Grade_B</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outIssueCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Grade_B</targetReference>
            </connector>
            <label>Grade B</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Create_Task</name>
        <label>Dec Create Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Report_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inCreateTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>outIssueCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Report_Task</targetReference>
            </connector>
            <label>Report Requested</label>
        </rules>
    </decisions>
    <description>Builds a data-quality grade (A/B/C) for an Account by combining AUT_Account_Duplicate_Finder, AUT_Asset_Warranty_Check, Contacts without e-mail and missing Account fields; optionally writes a report Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxContactEntry</name>
        <dataType>String</dataType>
        <expression>{!varContact.FirstName} &amp; ' ' &amp; {!varContact.LastName} &amp; '; '</expression>
    </formulas>
    <formulas>
        <name>fxIssues</name>
        <dataType>Number</dataType>
        <expression>{!varDuplicateCount} + {!varExpiredAssets} + {!varMissingEmail} + IF(ISBLANK({!Get_Account.Phone}), 1, 0) + IF(ISBLANK(TEXT({!Get_Account.Industry})), 1, 0) + IF(ISBLANK({!Get_Account.BillingCity}), 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxSummary</name>
        <dataType>String</dataType>
        <expression>'Grade ' &amp; {!outQualityGrade} &amp; ': ' &amp; TEXT({!outIssueCount}) &amp; ' issue(s); duplicates ' &amp; TEXT({!varDuplicateCount}) &amp; ', expired assets ' &amp; TEXT({!varExpiredAssets}) &amp; ', contacts without e-mail ' &amp; TEXT({!varMissingEmail})</expression>
    </formulas>
    <interviewLabel>AUT Account Data Quality Report {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Account Data Quality Report</label>
    <loops>
        <name>Loop_Contacts_No_Email</name>
        <label>Loop Contacts No Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varContact</assignNextValueToReference>
        <collectionReference>Filter_No_Email</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Collect_Contact</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Asg_Issue_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
