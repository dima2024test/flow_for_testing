            </connector>
            <label>Autolaunched</label>
        </rules>
        <rules>
            <name>Process_Builder</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProcessType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
