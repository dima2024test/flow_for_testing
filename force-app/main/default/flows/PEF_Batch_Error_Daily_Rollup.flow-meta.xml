    <description>Subscribes to BatchApexErrorEvent: appends each error to one rollup Task per day (created on first error), counts the day's errors and e-mails an active admin once the count reaches 10.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxToday</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>'[Flow Demo] Batch error rollup ' &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>fxLine</name>
        <dataType>String</dataType>
        <expression>TEXT(NOW()) &amp; ' | ' &amp; BLANKVALUE({!$Record.Phase}, '?') &amp; ' | ' &amp; BLANKVALUE({!$Record.ExceptionType}, '') &amp; ': ' &amp; LEFT(BLANKVALUE({!$Record.Message}, ''), 300)</expression>
    </formulas>
    <formulas>
        <name>fxAppended</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!Get_Rollup_Task.Description}, '') &amp; ' || ' &amp; {!fxLine}, 31000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'BatchApexRollup' &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Batch_Error_Daily_Rollup' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
    <interviewLabel>PEF Batch Error Daily Rollup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Batch Error Daily Rollup</label>
