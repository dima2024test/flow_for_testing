    <description>Subscribes to FlowExecutionErrorEvent: one open Case per failing flow (existing case gets the occurrence appended), owned by an active admin, plus a follow-up Task for the user who hit the error.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Flow failure: ' &amp; {!$Record.FlowApiName}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxAppended</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!Get_Open_Error_Case.Description}, '') &amp; ' || ' &amp; TEXT({!$Record.EventDate}) &amp; ' - ' &amp; {!$Record.ElementApiName} &amp; ': ' &amp; BLANKVALUE({!$Record.ErrorMessage}, ''), 31000)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Flow_Error_Case_Escalation' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
