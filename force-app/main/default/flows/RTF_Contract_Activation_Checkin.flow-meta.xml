        </inputAssignments>
        <inputAssignments>
            <name>inRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>ttActivation</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Contract {!$Record.ContractNumber} was activated for {!$Record.ContractTerm} month(s).
Other active contracts on the account: {!varActiveCount} covering {!varTotalTerm} month(s) in total.</text>
    </textTemplates>
    <textTemplates>
        <name>ttCheckin</name>
