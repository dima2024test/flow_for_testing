    <description>Re-scores a user's recent unconverted Leads (capped at the 25 newest per run) by calling AUT_Lead_Score_Calculator for each, counts Hot/Cold results and optionally e-mails a summary.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSince</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - BLANKVALUE({!inDaysBack}, 30)</expression>
    </formulas>
    <interviewLabel>AUT Lead Batch Scoring {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Lead Batch Scoring</label>
