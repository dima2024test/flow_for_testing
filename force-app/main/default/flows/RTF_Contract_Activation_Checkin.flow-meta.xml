<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Activation_Email</name>
        <label>Send Activation Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] Contract activated</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttActivation</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Sum_Term</name>
        <label>Asg Sum Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varActiveCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTotalTerm</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxTerm</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contracts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Case_Count</name>
        <label>Asg Case Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCaseCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Cases_Since_Activation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Checkin_Outcome</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_First_Contract</name>
        <label>Dec First Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Expansion_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Existing Customer</defaultConnectorLabel>
        <rules>
            <name>First_Contract</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varActiveCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Kickoff_Task</targetReference>
            </connector>
            <label>First Contract</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Checkin_Outcome</name>
        <label>Dec Checkin Outcome</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Checkin_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Healthy</defaultConnectorLabel>
        <rules>
            <name>At_Risk</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varCaseCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varHealthScore</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>40.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Risk_Task</targetReference>
            </connector>
            <label>At Risk</label>
        </rules>
    </decisions>
    <description>After-save when a Contract becomes Activated: totals the account's other active contracts (loop), creates a kickoff or expansion Task and e-mail. Scheduled path 30 days after ActivatedDate: account health subflow + case count since activation decide between an at-risk and a routine check-in Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxTerm</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!varContract.ContractTerm}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <interviewLabel>RTF Contract Activation Checkin {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Contract Activation Checkin</label>
    <loops>
        <name>Loop_Contracts</name>
        <label>Loop Contracts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varContract</assignNextValueToReference>
        <collectionReference>Get_Other_Active_Contracts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Sum_Term</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_First_Contract</targetReference>
        </noMoreValuesConnector>
    </loops>
