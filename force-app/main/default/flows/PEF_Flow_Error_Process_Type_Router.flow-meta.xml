    <decisions>
        <name>Dec_Case_Exists</name>
        <label>Dec Case Exists</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <defaultConnector>
            <targetReference>Create_Admin_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>First Failure</defaultConnectorLabel>
        <rules>
            <name>Case_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Router_Cases</targetReference>
            </connector>
            <label>Case Exists</label>
        </rules>
    </decisions>
    <description>Subscribes to FlowExecutionErrorEvent: routes by ProcessType - screen flow errors become a Task for the user who ran the interview, autolaunched / Process Builder errors become one admin-owned Case per flow (recurrences raise all open Cases to High).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCaseSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Background flow failure: ' &amp; {!$Record.FlowApiName}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxTaskSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Your flow run failed: ' &amp; {!$Record.FlowApiName}, 255)</expression>
    </formulas>
    <interviewLabel>PEF Flow Error Process Type Router {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Flow Error Process Type Router</label>
