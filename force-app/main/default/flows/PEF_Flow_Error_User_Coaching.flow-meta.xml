    <description>Subscribes to FlowExecutionErrorEvent: routes a coaching Task to the user's manager (or the user), counts the user's coaching tasks in the last 7 days and e-mails when the same user keeps hitting errors.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLast7Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Flow error coaching: ' &amp; {!$Record.FlowApiName}, 255)</expression>
    </formulas>
    <interviewLabel>PEF Flow Error User Coaching {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Flow Error User Coaching</label>
