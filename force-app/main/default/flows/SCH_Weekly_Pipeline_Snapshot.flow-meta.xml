    <collectionProcessors>
        <name>Filter_Closing_Soon</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Closing Soon</label>
        <locationX>314</locationX>
        <locationY>854</locationY>
        <assignNextValueToReference>currentItem_Filter_Closing_Soon</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Closing_Soon.CloseDate</leftValueReference>
            <operator>GreaterThanOrEqualTo</operator>
            <rightValue>
                <elementReference>$Flow.CurrentDate</elementReference>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Closing_Soon.CloseDate</leftValueReference>
            <operator>LessThanOrEqualTo</operator>
            <rightValue>
                <elementReference>fxIn30Days</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Closing_Soon</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Sort_By_Amount</name>
