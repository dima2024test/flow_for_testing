    <description>Turns an unconverted Lead into Account (reused if the company already exists) + Contact (+ optional Opportunity), marks the Lead as working and normalizes contact data via subflow. Does not use Lead Convert.</description>
    <dynamicChoiceSets>
        <name>LeadChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <limit>100</limit>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxOppName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!Get_Lead.Company} &amp; ' - From Lead', 120)</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 60</expression>
    </formulas>
