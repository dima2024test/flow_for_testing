    <description>Subscribes to FlowExecutionErrorEvent: maintains one open statistics Task per flow namespace (count in CallDurationInSeconds, newest errors first), sums all namespace counters and e-mails an admin every 10 errors while one namespace causes 50%+ of them.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNamespace</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.FlowNamespace}, 'local')</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Flow error stats - namespace ' &amp; {!fxNamespace}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxNextCount</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Ns_Stats.CallDurationInSeconds}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxLine</name>
        <dataType>String</dataType>
        <expression>TEXT(NOW()) &amp; ' ' &amp; {!$Record.FlowApiName} &amp; '/' &amp; BLANKVALUE({!$Record.ElementApiName}, '?') &amp; ': ' &amp; LEFT(BLANKVALUE({!$Record.ErrorMessage}, ''), 200)</expression>
    </formulas>
    <formulas>
        <name>fxAppended</name>
        <dataType>String</dataType>
        <expression>LEFT({!fxLine} &amp; ' || ' &amp; BLANKVALUE({!Get_Ns_Stats.Description}, ''), 31000)</expression>
    </formulas>
    <formulas>
        <name>fxShare</name>
        <dataType>Number</dataType>
        <expression>IF({!varTotal} &gt; 0, ROUND({!varMine} * 100 / {!varTotal}, 0), 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxNotify</name>
        <dataType>Boolean</dataType>
        <expression>AND({!varTotal} &gt;= 10, {!fxShare} &gt;= 50, MOD({!varMine}, 10) = 0)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Flow_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; BLANKVALUE({!$Record.FlowApiName}, '') &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Flow_Error_Namespace_Stats' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
