    <decisions>
        <name>Dec_Is_Failure</name>
        <label>Dec Is Failure</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Sub_Log_Alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Failure</defaultConnectorLabel>
        <rules>
            <name>Failure</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Fail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Rotation_Email</targetReference>
            </connector>
            <label>Failure</label>
        </rules>
    </decisions>
    <description>Subscribes to PlatformStatusAlertEvent: load-balances alert Tasks across all active System Administrators - counts each admin's alert Tasks created today (collection filter per admin) and assigns the new Task to the least-loaded one; e-mails on failures.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxToday</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Status alert: ' &amp; BLANKVALUE({!$Record.ServiceName}, 'service') &amp; ' / ' &amp; BLANKVALUE({!$Record.ComponentName}, 'component'), 255)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Alert_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PlatformStatusRotation' &amp; ' (' &amp; 'Warning' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Status_Alert_Admin_Rotation' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
