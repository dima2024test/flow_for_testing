    <constants>
        <name>cPlanSubject</name>
        <dataType>String</dataType>
        <value>
            <stringValue>[Flow Demo] Account health action plan</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Dec_High_Priority</name>
        <label>Dec High Priority</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>High_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCase.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_High_Case</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Next_Action</name>
        <label>Dec Next Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Scr_Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Action</defaultConnectorLabel>
        <rules>
            <name>Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Next_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Plan</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Old_Plans</targetReference>
            </connector>
            <label>Plan</label>
        </rules>
        <rules>
            <name>Escalate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Next_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalate</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Owner</targetReference>
            </connector>
            <label>Escalate</label>
        </rules>
    </decisions>
    <description>Pick an Account: shows the health score (subflow), pipeline summary (subflow) and open/high-priority case counts, then lets the user create an action-plan Task (replacing earlier open plans), e-mail the account owner, or do nothing.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxDueDefault</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <name>fxTaskPriority</name>
        <dataType>String</dataType>
        <expression>IF({!varRating} = 'Cold' || {!varHighCases} &gt; 0, 'High', 'Normal')</expression>
    </formulas>
    <formulas>
        <name>fxEmailSubject</name>
        <dataType>String</dataType>
        <expression>'Account health alert: ' &amp; {!Get_Account.Name} &amp; ' (' &amp; {!varRating} &amp; ')'</expression>
    </formulas>
    <interviewLabel>SCR Account Health Check Console {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Account Health Check Console</label>
    <loops>
        <name>Loop_Cases</name>
        <label>Loop Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varCase</assignNextValueToReference>
        <collectionReference>Get_Open_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_High_Priority</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Scr_Health_Results</targetReference>
        </noMoreValuesConnector>
    </loops>
