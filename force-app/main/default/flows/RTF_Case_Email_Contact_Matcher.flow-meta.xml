<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Unlinked_Alert</name>
        <label>Send Unlinked Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Create_Triage_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] High-priority case without contact</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttUnlinked</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Match_Count</name>
        <label>Asg Match Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMatchCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Matching_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Candidates</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Candidate</name>
        <label>Asg Candidate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varBestContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContact.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBestAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContact.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCandidateList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varContact.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCandidateList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> / </stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Candidates</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Priority_High</name>
        <label>Dec Priority High</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Triage_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Normal</defaultConnectorLabel>
        <rules>
            <name>High_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Unlinked_Alert</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Match_Result</name>
        <label>Dec Match Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_No_Match_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Single_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMatchCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Contact</targetReference>
            </connector>
            <label>Single Match</label>
        </rules>
        <rules>
            <name>Multiple_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMatchCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Review_Task</targetReference>
            </connector>
            <label>Multiple Matches</label>
        </rules>
    </decisions>
    <description>After-save on Case create without Contact but with a web e-mail: immediate triage Task (and alert for High priority). Async path matches Contacts by SuppliedEmail: one match links the Case and runs the contact snapshot; several matches create a review Task listing candidates; none creates a no-match Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxDueToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>RTF Case Email Contact Matcher {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Case Email Contact Matcher</label>
    <loops>
        <name>Loop_Candidates</name>
        <label>Loop Candidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varContact</assignNextValueToReference>
        <collectionReference>Get_Matching_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Candidate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Match_Result</targetReference>
        </noMoreValuesConnector>
    </loops>
