<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Summary_Email</name>
        <label>Send Summary Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] Nightly case aging report</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttReport</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Total</name>
        <label>Asg Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotal</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Aging_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Any_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Raise_Priority</name>
        <label>Asg Raise Priority</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCase.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colCasesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCase</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRaised</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Asg_Bucket_30</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Bucket_30</name>
        <label>Asg Bucket 30</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOver30</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Bucket_7</name>
        <label>Asg Bucket 7</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOver7</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Sort_By_Age</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort By Age</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Aging_Cases</collectionReference>
        <connector>
            <targetReference>Loop_Cases</targetReference>
        </connector>
        <limit>200</limit>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>CreatedDate</sortField>
            <sortOrder>Asc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Dec_Any_Cases</name>
        <label>Dec Any Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Summary_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sort_By_Age</targetReference>
            </connector>
            <label>Has Cases</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Age_Bucket</name>
        <label>Dec Age Bucket</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Bucket_7</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>7 to 30 Days</defaultConnectorLabel>
        <rules>
            <name>Over_30_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCase.CreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxCutoff30</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dec_Already_High</targetReference>
            </connector>
            <label>Over 30 Days</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Already_High</name>
        <label>Dec Already High</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Raise_Priority</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not High</defaultConnectorLabel>
        <rules>
            <name>Is_High</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCase.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Bucket_30</targetReference>
            </connector>
            <label>Is High</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Updates</name>
        <label>Dec Has Updates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Summary_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing To Update</defaultConnectorLabel>
        <rules>
            <name>Has_Updates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRaised</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Cases</targetReference>
            </connector>
            <label>Has Updates</label>
        </rules>
    </decisions>
    <description>Nightly batch (no object): loads open cases older than 7 days, sorts by age, buckets 7-30 / 30+ days, raises priority of 30+ day cases, then creates a summary Task and e-mails the report.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff7</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <name>fxCutoff30</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <interviewLabel>SCH Nightly Case Aging Report {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Nightly Case Aging Report</label>
    <loops>
        <name>Loop_Cases</name>
        <label>Loop Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varCase</assignNextValueToReference>
        <collectionReference>Get_Aging_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Age_Bucket</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Has_Updates</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
