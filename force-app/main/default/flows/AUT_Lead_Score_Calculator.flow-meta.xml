    <description>Campaign-free lead scoring: scores a Lead 0-100 from profile completeness, company size, lead source and logged activity, and writes Hot/Warm/Cold to Lead.Rating.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxScore</name>
        <dataType>Number</dataType>
        <expression>MIN(100, IF(ISBLANK({!Get_Lead.Email}), 0, 15) + IF(ISBLANK({!Get_Lead.Phone}), 0, 10) + IF(ISBLANK({!Get_Lead.Title}), 0, 10) + IF(BLANKVALUE({!Get_Lead.AnnualRevenue}, 0) &gt; 1000000, 20, IF(BLANKVALUE({!Get_Lead.AnnualRevenue}, 0) &gt; 0, 10, 0)) + IF(BLANKVALUE({!Get_Lead.NumberOfEmployees}, 0) &gt; 200, 15, IF(BLANKVALUE({!Get_Lead.NumberOfEmployees}, 0) &gt; 0, 5, 0)) + IF(ISBLANK(TEXT({!Get_Lead.Industry})), 0, 5) + IF(TEXT({!Get_Lead.LeadSource}) = 'Partner Referral', 15, IF(TEXT({!Get_Lead.LeadSource}) = 'Web', 10, 0)) + MIN(15, {!varActivityPoints}))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>AUT Lead Score Calculator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Lead Score Calculator</label>
