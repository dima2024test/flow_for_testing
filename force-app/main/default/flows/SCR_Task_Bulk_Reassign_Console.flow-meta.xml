    <formulas>
        <name>fxIsOverdue</name>
        <dataType>Number</dataType>
        <expression>IF(AND(NOT(ISBLANK({!varTask.ActivityDate})), {!varTask.ActivityDate} &lt; TODAY()), 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxIsHigh</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!varTask.Priority}) = 'High', 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxEmailSubject</name>
        <dataType>String</dataType>
        <expression>TEXT({!varMoved}) &amp; ' task(s) were reassigned to you'</expression>
    </formulas>
