    <decisions>
        <name>Dec_Threshold</name>
        <label>Dec Threshold</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Sub_Log_Batch_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below Threshold</defaultConnectorLabel>
        <rules>
            <name>Threshold_Reached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>25.0</numberValue>
