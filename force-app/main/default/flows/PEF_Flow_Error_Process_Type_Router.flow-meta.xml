                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProcessType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>InvocableProcess</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProcessType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CustomEvent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Process_Builder</targetReference>
            </connector>
            <label>Process Builder</label>
        </rules>
    </decisions>
