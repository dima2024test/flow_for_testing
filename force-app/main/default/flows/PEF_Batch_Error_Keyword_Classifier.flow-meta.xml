    <decisions>
        <name>Dec_Keyword</name>
        <label>Dec Keyword</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Unclassified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unclassified</defaultConnectorLabel>
        <rules>
            <name>Row_Lock</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>UNABLE_TO_LOCK_ROW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Locking</targetReference>
            </connector>
            <label>Row Lock</label>
        </rules>
        <rules>
            <name>Governor_Limit</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Too many SOQL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Too many DML</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Limits</targetReference>
            </connector>
            <label>Governor Limit</label>
        </rules>
        <rules>
            <name>Resources</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CPU time</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>heap size</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Resources</targetReference>
            </connector>
            <label>Resources</label>
        </rules>
        <rules>
            <name>Data_Quality</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Message</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>REQUIRED_FIELD_MISSING</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Data</targetReference>
            </connector>
            <label>Data Quality</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Is_Stale</name>
        <label>Dec Is Stale</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Count_Fresh</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Fresh</defaultConnectorLabel>
        <rules>
            <name>Stale</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCat.CreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxWeekAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Close_Stale</targetReference>
            </connector>
            <label>Stale</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Fresh_Exists</name>
        <label>Dec Fresh Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Category_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Current</defaultConnectorLabel>
        <rules>
            <name>Fresh_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFreshCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Log_Batch_Error</targetReference>
            </connector>
            <label>Fresh Exists</label>
        </rules>
    </decisions>
    <description>Subscribes to BatchApexErrorEvent: classifies the error message by keyword (row lock, governor limits, CPU/heap, data validation), closes category Tasks older than 7 days and opens a fresh category Task with remediation advice when none is current.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxWeekAgo</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>'[Flow Demo] Batch error category: ' &amp; {!varCategory}</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Batch_Error_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'BatchApexKeyword' &amp; ' (' &amp; 'Error' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Batch_Error_Keyword_Classifier' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
    <interviewLabel>PEF Batch Error Keyword Classifier {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Batch Error Keyword Classifier</label>
