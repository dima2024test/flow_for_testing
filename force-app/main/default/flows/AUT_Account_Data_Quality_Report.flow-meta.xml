            </value>
        </assignmentItems>
        <connector>
            <targetReference>Asg_Summary</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Grade_C</name>
        <label>Asg Grade C</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outQualityGrade</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>C</stringValue>
            </value>
        </assignmentItems>
        <connector>
