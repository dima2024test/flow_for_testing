    <textTemplates>
        <name>ttFix</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Flow {!$Record.FlowApiName} failed at {!$Record.ElementApiName} ({!$Record.ElementType}).
Error: {!$Record.ErrorMessage}
Interview {!$Record.InterviewGuid} started {!$Record.InterviewStartDate} by user {!$Record.InterviewStartedById}.
Routing: {!varRouting}
User workload: {!varOpenCount} open / {!varOverdue} overdue tasks.</text>
    </textTemplates>
    <textTemplates>
        <name>ttHandover</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>User {!Get_Interview_User.Username} is deactivated but started flow {!$Record.FlowApiName}, which failed: {!$Record.ErrorMessage}
{!varMoved} open tasks were reassigned to you.</text>
    </textTemplates>
