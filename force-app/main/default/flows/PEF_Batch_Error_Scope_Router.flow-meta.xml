    <description>Subscribes to BatchApexErrorEvent: takes the first record Id from JobScope, detects its object by key prefix (Account / Opportunity / Case), loads it and attaches a Task to that record and its owner; otherwise a general Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxFirstId</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE(BLANKVALUE({!$Record.JobScope}, ''), ' ', ''), 18)</expression>
    </formulas>
    <formulas>
        <name>fxPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!varFirstId}, 3)</expression>
    </formulas>
    <interviewLabel>PEF Batch Error Scope Router {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Batch Error Scope Router</label>
