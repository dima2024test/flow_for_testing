    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Contact_Count</name>
        <label>Asg Contact Count</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>varContactCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Account_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Has_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Use_Filtered</name>
        <label>Asg Use Filtered</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <assignmentItems>
            <assignToReference>colTargets</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Filter_Contacts_With_Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Targets</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Use_All</name>
        <label>Asg Use All</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <assignmentItems>
            <assignToReference>colTargets</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Targets</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Build_Task</name>
        <label>Asg Build Task</label>
        <locationX>50</locationX>
        <locationY>1526</locationY>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxTaskSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.WhoId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContact.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxDueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Task_Priority</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTaskCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Targets</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Contacts_With_Email</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Contacts With Email</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <assignNextValueToReference>currentItem_Filter_Contacts_With_Email</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Account_Contacts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Contacts_With_Email.Email</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Use_Filtered</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Has_Contacts</name>
        <label>Dec Has Contacts</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Scr_No_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contacts</defaultConnectorLabel>
        <rules>
            <name>Has_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContactCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Plan_Details</targetReference>
            </connector>
            <label>Has Contacts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Filter_Option</name>
        <label>Dec Filter Option</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Asg_Use_All</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Contacts</defaultConnectorLabel>
        <rules>
            <name>Email_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Only_With_Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Contacts_With_Email</targetReference>
            </connector>
            <label>Email Only</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Any_Tasks</name>
        <label>Dec Any Tasks</label>
        <locationX>314</locationX>
        <locationY>1526</locationY>
        <defaultConnector>
            <targetReference>Scr_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Tasks</defaultConnectorLabel>
        <rules>
            <name>Has_Tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTaskCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Tasks</targetReference>
            </connector>
            <label>Has Tasks</label>
        </rules>
    </decisions>
    <description>Pick an Account and plan a Task for each of its contacts (optionally only those with an e-mail), built in a loop and inserted in one bulk create.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>TaskPriorityChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Priority</picklistField>
        <picklistObject>Task</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxTaskSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!Task_Subject} &amp; ' - ' &amp; {!varContact.LastName}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!Days_Until_Due}</expression>
    </formulas>
    <interviewLabel>SCR Account Task Planner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Account Task Planner</label>
    <loops>
        <name>Loop_Targets</name>
        <label>Loop Targets</label>
        <locationX>314</locationX>
        <locationY>1358</locationY>
        <assignNextValueToReference>varContact</assignNextValueToReference>
        <collectionReference>colTargets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Build_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Any_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Tasks</name>
        <label>Create Tasks</label>
        <locationX>50</locationX>
        <locationY>1694</locationY>
        <connector>
            <targetReference>Scr_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sub_Log_Fault</targetReference>
        </faultConnector>
        <inputReference>colTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Account_Contacts</name>
        <label>Get Account Contacts</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Contact_Count</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sub_Log_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>LastName</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
