    <decisions>
        <name>Dec_Status_Kind</name>
        <label>Dec Status Kind</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Dec_Already_Tracked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Degraded</defaultConnectorLabel>
        <rules>
            <name>Recovered</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Resol</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Recover</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StatusType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Open_Tasks</targetReference>
            </connector>
            <label>Recovered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Already_Tracked</name>
        <label>Dec Already Tracked</label>
        <locationX>314</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Create_Tracking_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Tracked</defaultConnectorLabel>
        <rules>
            <name>Tracked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Log_Alert</targetReference>
            </connector>
            <label>Tracked</label>
        </rules>
    </decisions>
    <description>Subscribes to PlatformStatusAlertEvent: tracks degraded components with one open Task per component/sub-component; a resolved/recovered/success status bulk-completes the open tracking Tasks, a new degradation opens one and e-mails an admin.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxComponentKey</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.ComponentName}, 'Unknown component') &amp; IF(ISBLANK({!$Record.SubComponentName}), '', ' / ' &amp; {!$Record.SubComponentName})</expression>
    </formulas>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Component degraded: ' &amp; {!fxComponentKey}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxClosingNote</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!varOpen.Description}, '') &amp; ' || Recovered ' &amp; TEXT({!$Record.EventDate}) &amp; ': ' &amp; BLANKVALUE({!$Record.StatusType}, ''), 31000)</expression>
    </formulas>
    <formulas>
        <name>fxSub_Log_Alert_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PlatformComponentRecovery' &amp; ' (' &amp; 'Warning' &amp; ')', 255)</expression>
    </formulas>
    <formulas>
        <name>fxLog_Fault_Subject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Error] ' &amp; 'PEF_Status_Alert_Component_Recovery' &amp; ' (' &amp; 'Critical' &amp; ')', 255)</expression>
    </formulas>
