                <elementReference>varContract.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxDue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
