    <decisions>
        <name>Dec_Won_Or_Lost</name>
        <label>Dec Won Or Lost</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnector>
            <targetReference>Create_Loss_Review_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Lost</defaultConnectorLabel>
        <rules>
            <name>Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsWon</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Won</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Promote_Account</name>
        <label>Dec Promote Account</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Get_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Customer</defaultConnectorLabel>
        <rules>
            <name>Needs_Promotion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer - Direct</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Type</targetReference>
            </connector>
            <label>Needs Promotion</label>
        </rules>
    </decisions>
    <description>After-save when an Opportunity becomes closed. Won: promote Account type, sum line-item quantity, onboarding Task + e-mail. Lost: loss-review Task and close open demo Tasks. Scheduled path CloseDate+7 days recalculates Account health.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxQuantity</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!varLineItem.Quantity}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <interviewLabel>RTF Opportunity Closed Processing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Opportunity Closed Processing</label>
