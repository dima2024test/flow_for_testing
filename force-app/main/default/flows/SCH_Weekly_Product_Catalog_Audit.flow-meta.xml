    <collectionProcessors>
        <name>Filter_New_Products</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter New Products</label>
        <locationX>314</locationX>
        <locationY>854</locationY>
        <assignNextValueToReference>currentItem_Filter_New_Products</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Active_Products</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_New_Products.CreatedDate</leftValueReference>
            <operator>GreaterThan</operator>
