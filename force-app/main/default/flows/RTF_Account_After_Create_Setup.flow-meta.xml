            </connector>
            <label>Prospect</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Duplicates</name>
        <label>Dec Has Duplicates</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Sub_Normalize_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicates</defaultConnectorLabel>
        <rules>
            <name>Duplicates_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDuplicateCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Duplicates</targetReference>
            </connector>
            <label>Duplicates Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Score_Low</name>
        <label>Dec Score Low</label>
        <locationX>842</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Healthy</defaultConnectorLabel>
        <rules>
            <name>Low_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHealthScore</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
