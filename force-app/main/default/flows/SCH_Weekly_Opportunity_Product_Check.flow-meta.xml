<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Item_Count</name>
        <label>Asg Item Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varItemCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Line_Items</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Has_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Totals</name>
        <label>Asg Totals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varLineTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxLineTotal</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUnits</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxQty</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Discount_Count</name>
        <label>Asg Discount Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDiscounted</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Filter_High_Discount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Discount_Review</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_High_Discount</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter High Discount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_High_Discount</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Line_Items</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_High_Discount.Discount</leftValueReference>
            <operator>GreaterThan</operator>
            <rightValue>
                <numberValue>20.0</numberValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Asg_Discount_Count</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Has_Items</name>
        <label>Dec Has Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Gap_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Products</defaultConnectorLabel>
        <rules>
            <name>Has_Items</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varItemCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Items</targetReference>
            </connector>
            <label>Has Items</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Gap_Task_Exists</name>
        <label>Dec Gap Task Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_No_Products_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Gap_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Discount_Review</name>
        <label>Dec Discount Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Dec_Has_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Normal Pricing</defaultConnectorLabel>
        <rules>
            <name>Needs_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDiscounted</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Discount_Task</targetReference>
            </connector>
            <label>Needs Review</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Account</name>
        <label>Dec Has Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Next_Step</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Pipeline_Summary</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <description>Weekly, per Qualification/Needs Analysis Opportunity: deals without products get a de-duplicated Task; otherwise line items are totalled, discounts over 20% trigger a review Task, and NextStep is updated with product and account pipeline totals.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLineTotal</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varItem.TotalPrice}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxQty</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!varItem.Quantity}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxNextStep</name>
        <dataType>String</dataType>
        <expression>LEFT('Products: ' &amp; TEXT({!varUnits}) &amp; ' units / ' &amp; TEXT({!varLineTotal}) &amp; '; account pipeline ' &amp; TEXT({!varAccountPipeline}), 255)</expression>
    </formulas>
    <interviewLabel>SCH Weekly Opportunity Product Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Opportunity Product Check</label>
    <loops>
        <name>Loop_Items</name>
        <label>Loop Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varItem</assignNextValueToReference>
        <collectionReference>Get_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Totals</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Filter_High_Discount</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
