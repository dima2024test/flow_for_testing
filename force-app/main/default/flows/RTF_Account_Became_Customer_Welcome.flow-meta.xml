    <description>After-save when an Account's Type changes to a Customer value: if it was a Prospect ($Record__Prior), creates welcome-call Tasks for up to 5 contacts with e-mail (sort + loop + bulk create), otherwise a type-change Task; notifies by e-mail. Async path: contact normalizer + health calculator subflows, low-health Task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 3</expression>
    </formulas>
    <formulas>
        <name>fxPriorType</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!$Record__Prior.Type}), 'blank')</expression>
    </formulas>
    <formulas>
        <name>fxWelcomeSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Welcome call - ' &amp; {!varContact.FirstName} &amp; ' ' &amp; {!varContact.LastName}, 255)</expression>
    </formulas>
    <interviewLabel>RTF Account Became Customer Welcome {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Account Became Customer Welcome</label>
    <loops>
