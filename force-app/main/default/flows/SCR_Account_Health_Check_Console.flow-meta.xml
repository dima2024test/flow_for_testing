    <choices>
        <name>chPlan</name>
        <choiceText>Create an action plan task</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Plan</stringValue>
        </value>
    </choices>
    <choices>
        <name>chEscalate</name>
        <choiceText>Email the account owner</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Escalate</stringValue>
        </value>
    </choices>
    <choices>
        <name>chNone</name>
        <choiceText>No action</choiceText>
        <dataType>String</dataType>
        <value>
