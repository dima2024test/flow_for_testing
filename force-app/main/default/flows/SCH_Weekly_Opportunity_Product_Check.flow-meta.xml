    <recordCreates>
        <name>Create_Discount_Task</name>
        <label>Create Discount Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Dec_Has_Account</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
