    <decisions>
        <name>Dec_Contact_Found</name>
        <label>Dec Contact Found</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Asg_Unknown</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Tasks</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Overdue</name>
        <label>Dec Overdue</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Loop_Tasks</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>On Time</defaultConnectorLabel>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTask.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Count_Overdue</targetReference>
            </connector>
            <label>Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Engagement</name>
        <label>Dec Engagement</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Asg_Dormant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dormant</defaultConnectorLabel>
        <rules>
            <name>At_Risk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outOverdueTasks</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_At_Risk</targetReference>
            </connector>
            <label>At Risk</label>
        </rules>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outOpenTasks</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Active</targetReference>
            </connector>
            <label>Active</label>
        </rules>
    </decisions>
    <description>Returns open/overdue task and open case counts for a Contact plus an engagement label; flags heavily overdue contacts with a Task.</description>
