    <decisions>
        <name>Dec_Any_Overdue</name>
        <label>Dec Any Overdue</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>Nothing Overdue</defaultConnectorLabel>
        <rules>
            <name>Has_Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sort_By_Due_Date</targetReference>
            </connector>
            <label>Has Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Very_Old</name>
        <label>Dec Very Old</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Loop_Overdue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Recent</defaultConnectorLabel>
        <rules>
            <name>Very_Old</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTask.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxCutoff14</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varTask.Priority</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Escalate</targetReference>
            </connector>
            <label>Very Old</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Escalations</name>
        <label>Dec Has Escalations</label>
        <locationX>314</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Create_Digest_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Escalations</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEscalated</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tasks</targetReference>
            </connector>
            <label>Has Escalations</label>
        </rules>
    </decisions>
    <description>Daily batch (no object): collects overdue open Tasks, sorts by due date, escalates those overdue 14+ days to High, builds a digest of the oldest 50 and stores/e-mails it.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxCutoff14</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 14</expression>
    </formulas>
    <formulas>
        <name>fxLine</name>
        <dataType>String</dataType>
        <expression>LEFT({!varTask.Subject}, 80) &amp; ' (due ' &amp; TEXT({!varTask.ActivityDate}) &amp; ')'</expression>
    </formulas>
    <interviewLabel>SCH Daily Overdue Task Digest {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Daily Overdue Task Digest</label>
    <loops>
        <name>Loop_Overdue</name>
        <label>Loop Overdue</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignNextValueToReference>varTask</assignNextValueToReference>
        <collectionReference>Get_Overdue_Tasks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
