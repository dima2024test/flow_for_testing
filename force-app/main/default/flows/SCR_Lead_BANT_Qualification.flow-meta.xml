    <decisions>
        <name>Dec_Score_Band</name>
        <label>Dec Score Band</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asg_Cold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cold</defaultConnectorLabel>
        <rules>
            <name>Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxBantScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>70.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Hot</targetReference>
            </connector>
            <label>Hot</label>
        </rules>
        <rules>
            <name>Warm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxBantScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>40.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Warm</targetReference>
            </connector>
            <label>Warm</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Apply_Siblings</name>
        <label>Dec Apply Siblings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Dec_Hot_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Only This Lead</defaultConnectorLabel>
        <rules>
            <name>Apply_Siblings</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Apply_To_Company</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.Company</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Leads</targetReference>
            </connector>
            <label>Apply Siblings</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Hot_Task</name>
        <label>Dec Hot Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Scr_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Hot_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Call_Task</targetReference>
            </connector>
            <label>Hot Lead</label>
        </rules>
    </decisions>
    <description>BANT survey for an open Lead: Budget/Authority/Need/Timeline answers produce a 0-100 score, set Rating/Status and a summary on the Lead, optionally copy the rating to other open leads of the same company, create a call Task for hot leads.</description>
    <dynamicChoiceSets>
        <name>LeadChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed - Not Converted</stringValue>
            </value>
        </filters>
        <limit>100</limit>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxBantScore</name>
        <dataType>Number</dataType>
        <expression>VALUE({!Budget_Answer}) + VALUE({!Authority_Answer}) + VALUE({!Need_Answer}) + VALUE({!Timeline_Answer})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxCallDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <interviewLabel>SCR Lead BANT Qualification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Lead BANT Qualification</label>
    <loops>
        <name>Loop_Siblings</name>
        <label>Loop Siblings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varSibling</assignNextValueToReference>
        <collectionReference>Get_Sibling_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Sibling</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Siblings</targetReference>
        </noMoreValuesConnector>
    </loops>
