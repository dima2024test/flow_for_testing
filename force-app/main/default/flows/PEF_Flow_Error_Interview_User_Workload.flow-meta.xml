    <decisions>
        <name>Dec_User_State</name>
        <label>Dec User State</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Asg_Owner_Admin</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unknown User</defaultConnectorLabel>
        <rules>
            <name>Deactivated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Interview_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Interview_User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Reassign_Open_Tasks</targetReference>
            </connector>
            <label>Deactivated</label>
        </rules>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Interview_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Interview_User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_User_Open_Tasks</targetReference>
            </connector>
            <label>Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Is_Overdue</name>
        <label>Dec Is Overdue</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <defaultConnector>
            <targetReference>Loop_User_Tasks</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>On Time</defaultConnectorLabel>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTask.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Count_Overdue</targetReference>
            </connector>
            <label>Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Overloaded</name>
        <label>Dec Overloaded</label>
        <locationX>314</locationX>
        <locationY>1358</locationY>
        <defaultConnector>
            <targetReference>Asg_Owner_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Capacity OK</defaultConnectorLabel>
        <rules>
            <name>Overloaded</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOverdue</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpenCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Owner_Admin</targetReference>
            </connector>
            <label>Overloaded</label>
        </rules>
    </decisions>
    <description>Subscribes to FlowExecutionErrorEvent: checks the user who started the interview - if deactivated, hands their open Tasks to an admin via the bulk-reassign subflow; if active, measures open/overdue Task workload and gives the fix Task to the user or, when overloaded, to an admin.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Fix flow error: ' &amp; {!$Record.FlowApiName}, 255)</expression>
    </formulas>
    <interviewLabel>PEF Flow Error Interview User Workload {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PEF Flow Error Interview User Workload</label>
