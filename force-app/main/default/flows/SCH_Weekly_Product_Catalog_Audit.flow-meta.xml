            </connector>
            <label>Has Products</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Data_Gap</name>
        <label>Dec Data Gap</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Loop_Products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Complete</defaultConnectorLabel>
        <rules>
            <name>Missing_Code</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varProduct.ProductCode</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Missing_Code</targetReference>
            </connector>
            <label>Missing Code</label>
        </rules>
        <rules>
            <name>Missing_Family</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varProduct.Family</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
