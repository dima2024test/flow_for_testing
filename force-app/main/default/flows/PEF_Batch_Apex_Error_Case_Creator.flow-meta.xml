    <description>Subscribes to BatchApexErrorEvent: de-duplicates by exception type, appends to the newest open Case if one exists, otherwise creates a new Case (owner = active admin) with phase-based priority and notifies by e-mail.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxSubject</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Batch failure: ' &amp; BLANKVALUE({!$Record.ExceptionType}, 'Unknown exception'), 255)</expression>
    </formulas>
    <formulas>
        <name>fxAppendedDescription</name>
        <dataType>String</dataType>
        <expression>LEFT(BLANKVALUE({!varCase.Description}, '') &amp; ' || ' &amp; '--- Repeat at ' &amp; TEXT(NOW()) &amp; ': ' &amp; BLANKVALUE({!$Record.Message}, ''), 31000)</expression>
    </formulas>
