<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Opp_Count</name>
        <label>Asg Opp Count</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>varOpenOpps</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Opportunities</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Open_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Case_Count</name>
        <label>Asg Case Count</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <assignmentItems>
            <assignToReference>varOpenCases</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Open_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Activity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Stale</name>
        <label>Dec Stale</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnectorLabel>Recently Active</defaultConnectorLabel>
        <rules>
            <name>Stale</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastModifiedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxStaleCutoff</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Opportunities</targetReference>
            </connector>
            <label>Stale</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Activity</name>
        <label>Dec Activity</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnectorLabel>Only Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Open_Deals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenOpps</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Pipeline_Summary</targetReference>
            </connector>
            <label>Has Open Deals</label>
        </rules>
        <rules>
            <name>Nothing_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpenCases</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dec_Already_Cold</targetReference>
            </connector>
            <label>Nothing Open</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Already_Cold</name>
        <label>Dec Already Cold</label>
        <locationX>314</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Cold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Cold</defaultConnectorLabel>
        <rules>
            <name>Already_Cold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cold</stringValue>
                </rightValue>
            </conditions>
            <label>Already Cold</label>
        </rules>
    </decisions>
    <description>Weekly, per customer Account not modified for 180 days: no open deals or cases -&gt; rating Cold + review Task; open deals -&gt; re-engagement Task with pipeline numbers from subflow.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxStaleCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 180</expression>
    </formulas>
    <interviewLabel>SCH Weekly Inactive Account Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCH Weekly Inactive Account Review</label>
    <processMetadataValues>
        <name>BuilderType</name>
