<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Duplicate_Count</name>
        <label>Asg Duplicate Count</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>varDuplicateCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Duplicate_Accounts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Duplicates</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>chContinue</name>
        <choiceText>Create it anyway</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Continue</stringValue>
        </value>
    </choices>
    <choices>
        <name>chCancel</name>
        <choiceText>Cancel</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Cancel</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Dec_Duplicates</name>
        <label>Dec Duplicates</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <defaultConnector>
            <targetReference>Create_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unique</defaultConnectorLabel>
        <rules>
            <name>Duplicates_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDuplicateCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Duplicate_Warning</targetReference>
            </connector>
            <label>Duplicates Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_User_Choice</name>
        <label>Dec User Choice</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <defaultConnector>
            <targetReference>Scr_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Continue_Anyway</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Duplicate_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Continue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Account</targetReference>
            </connector>
            <label>Continue Anyway</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Create_Opportunity</name>
        <label>Dec Create Opportunity</label>
        <locationX>50</locationX>
        <locationY>1358</locationY>
        <defaultConnector>
            <targetReference>Sub_Health_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Create_Opportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Opportunity</targetReference>
            </connector>
            <label>Opportunity Requested</label>
        </rules>
    </decisions>
    <description>Wizard: capture Account details, warn about duplicate names, create Account + primary Contact (+ optional Opportunity) and show the calculated health score.</description>
    <dynamicChoiceSets>
        <name>IndustryChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Industry</picklistField>
        <picklistObject>Account</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxOppName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!Account_Name} &amp; ' - New Business', 120)</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 45</expression>
    </formulas>
    <interviewLabel>SCR New Customer Onboarding {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR New Customer Onboarding</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
