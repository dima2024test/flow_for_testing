        <value>
            <stringValue>Customer request</stringValue>
        </value>
    </choices>
    <choices>
        <name>chConflict</name>
        <choiceText>Internal conflict</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Internal conflict</stringValue>
        </value>
    </choices>
    <choices>
        <name>chTravel</name>
        <choiceText>Travel / logistics</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Travel</stringValue>
        </value>
    </choices>
    <choices>
        <name>chProceed</name>
        <choiceText>Move it anyway</choiceText>
