<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Dup_Count</name>
        <label>Asg Dup Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDupCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Serial_Duplicates</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Duplicate_Serial</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Tally_Asset</name>
        <label>Asg Tally Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssetCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBaseValue</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxAssetValue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTopAssets</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxAssetLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Assets</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Sort_Assets</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Account_Assets</collectionReference>
        <connector>
            <targetReference>Loop_Assets</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>Price</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Dec_Duplicate_Serial</name>
        <label>Dec Duplicate Serial</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Asset</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unique</defaultConnectorLabel>
        <rules>
            <name>Serial_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDupCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scr_Duplicate_Serial</targetReference>
            </connector>
            <label>Serial Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Install_Task</name>
        <label>Dec Install Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Install_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Schedule_Install</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Install_Task</targetReference>
            </connector>
            <label>Install Requested</label>
        </rules>
    </decisions>
    <description>Register a customer Asset: pick Account and (optional) Contact, enter serial/price/dates, warn about duplicate serial numbers, create the Asset (+ optional install Task) and show the account's installed base sorted by value.</description>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <limit>200</limit>
        <object>Account</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ContactChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Account_Picker</elementReference>
            </value>
        </filters>
        <limit>200</limit>
        <object>Contact</object>
        <sortField>LastName</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>AssetStatusChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Status</picklistField>
        <picklistObject>Asset</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxAssetName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] ' &amp; {!Asset_Name}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxInstallDue</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!Install_Date}, TODAY() + 7)</expression>
    </formulas>
    <formulas>
        <name>fxAssetValue</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varAsset.Price}, 0) * BLANKVALUE({!varAsset.Quantity}, 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxAssetLine</name>
        <dataType>String</dataType>
        <expression>{!varAsset.Name} &amp; ' [' &amp; BLANKVALUE(TEXT({!varAsset.Status}), 'n/a') &amp; '] ' &amp; TEXT({!fxAssetValue}) &amp; '; '</expression>
    </formulas>
    <interviewLabel>SCR Asset Registration Wizard {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SCR Asset Registration Wizard</label>
    <loops>
        <name>Loop_Assets</name>
        <label>Loop Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varAsset</assignNextValueToReference>
        <collectionReference>Get_Account_Assets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Tally_Asset</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Scr_Summary</targetReference>
        </noMoreValuesConnector>
    </loops>
