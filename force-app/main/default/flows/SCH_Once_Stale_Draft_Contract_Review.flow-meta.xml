            <value>
                <stringValue>[Flow Demo] Draft contract past start date - activate or cancel</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContract.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
