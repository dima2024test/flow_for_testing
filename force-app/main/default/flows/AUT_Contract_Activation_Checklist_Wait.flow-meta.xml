    <description>For a Draft Contract: checks the Account's asset warranties, creates a 3-item activation checklist (bulk Task insert), waits 7 days, then activates the Contract when all items are completed or e-mails a reminder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fxItemSubject</name>
        <dataType>String</dataType>
        <expression>'[Flow Demo] Activation: ' &amp; {!varItem}</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <interviewLabel>AUT Contract Activation Checklist Wait {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AUT Contract Activation Checklist Wait</label>
