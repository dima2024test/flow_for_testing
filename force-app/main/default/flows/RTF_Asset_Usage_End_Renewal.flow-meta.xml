<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Add_Value</name>
        <label>Asg Add Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExpiringCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varExpiringValue</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxAssetValue</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Assets</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Own_Assets</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Own Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Own_Assets</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Expiring_Assets</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Own_Assets.IsCompetitorProduct</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Assets</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Dec_Bundle_Renewal</name>
        <label>Dec Bundle Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Single Renewal</defaultConnectorLabel>
        <rules>
            <name>Bundle_Candidate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExpiringCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Bundle_Task</targetReference>
            </connector>
            <label>Bundle Candidate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Still_Due</name>
        <label>Dec Still Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Due</defaultConnectorLabel>
        <rules>
            <name>Still_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset_Later.UsageEndDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Asset_Later.IsCompetitorProduct</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Renewal</targetReference>
            </connector>
            <label>Still Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Renewal_Exists</name>
        <label>Dec Renewal Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Renewal_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Renewal</defaultConnectorLabel>
        <rules>
            <name>Renewal_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Renewal</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Renewal Exists</label>
        </rules>
    </decisions>
    <description>After-save when an Asset gets a UsageEndDate: sums the account's own (non-competitor) assets ending within 90 days (collection filter + loop) and suggests a bundled renewal. Scheduled path 14 days before UsageEndDate creates a renewal Opportunity (if none open) and refreshes the pipeline summary.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxIn90Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <formulas>
        <name>fxAssetValue</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varAsset.Price}, 0) * BLANKVALUE({!varAsset.Quantity}, 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxRenewalName</name>
        <dataType>String</dataType>
        <expression>LEFT('[Flow Demo] Renewal - ' &amp; {!$Record.Name}, 120)</expression>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <interviewLabel>RTF Asset Usage End Renewal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Asset Usage End Renewal</label>
    <loops>
        <name>Loop_Assets</name>
        <label>Loop Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varAsset</assignNextValueToReference>
        <collectionReference>Filter_Own_Assets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Add_Value</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Bundle_Renewal</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
