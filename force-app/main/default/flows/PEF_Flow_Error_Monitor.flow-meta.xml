        </connector>
        <object>FlowExecutionErrorEvent</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttAlert</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Flow {!$Record.FlowApiName} failed {!varRecentCount} times in the last 24h.
Last element: {!$Record.ElementApiName} ({!$Record.ElementType})
User: {!varUserLabel}
Error: {!$Record.ErrorMessage}</text>
    </textTemplates>
    <textTemplates>
        <name>ttSub_Log_Flow_Error_Details</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
