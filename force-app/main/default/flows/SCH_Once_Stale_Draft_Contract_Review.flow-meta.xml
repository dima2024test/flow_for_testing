            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPastStart</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contracts</targetReference>
        </connector>
