        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttDescription</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Flow: {!inFlowName}
Severity: {!inSeverity}
Record: {!inRecordId}
Running user: {!$User.Username}
Logged at: {!$Flow.CurrentDateTime}
Error message:
{!inErrorMessage}</text>
