<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Removal_Email</name>
        <label>Send Removal Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>[Flow Demo] Product removed from closed opportunity</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttRemoval</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Accumulate</name>
        <label>Asg Accumulate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varRemainingTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fxItemValue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRemainingCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Deal_State</name>
        <label>Dec Deal State</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Closed_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Closed_Deal_Task</targetReference>
            </connector>
            <label>Closed Deal</label>
        </rules>
        <rules>
            <name>Open_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Remaining_Items</targetReference>
            </connector>
            <label>Open Deal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Last_Product</name>
        <label>Dec Last Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Dec_Large_Removal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Products Remain</defaultConnectorLabel>
        <rules>
            <name>Last_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRemainingCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Empty_Deal_Task</targetReference>
            </connector>
            <label>Last Product</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Large_Removal</name>
        <label>Dec Large Removal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Dec_Has_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Small Line</defaultConnectorLabel>
        <rules>
            <name>Large_Line</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxDeletedValue</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>10000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Large_Removal_Task</targetReference>
            </connector>
            <label>Large Line</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Account</name>
        <label>Dec Has Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Pipeline_Summary</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <description>Before-delete on OpportunityLineItem: on closed deals raises an alert Task + e-mail; on open deals totals the remaining product lines and creates a Task when the last product or a large line is removed, then refreshes the pipeline summary.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxDeletedValue</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record.TotalPrice}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxItemValue</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!varItem.TotalPrice}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel>RTF Opportunity Product Before Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Opportunity Product Before Delete</label>
    <loops>
        <name>Loop_Items</name>
        <label>Loop Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>varItem</assignNextValueToReference>
        <collectionReference>Get_Remaining_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Asg_Accumulate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Last_Product</targetReference>
        </noMoreValuesConnector>
    </loops>
