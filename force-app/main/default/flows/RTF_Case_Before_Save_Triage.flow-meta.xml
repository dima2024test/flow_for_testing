<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Asg_Account_Context</name>
        <label>Asg Account Context</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>varAccountRating</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account.Rating</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccountType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account.Type</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Has_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Increment_Open</name>
        <label>Asg Increment Open</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <assignmentItems>
            <assignToReference>varOpenCaseCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contact_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Priority_High</name>
        <label>Asg Priority High</label>
        <locationX>314</locationX>
        <locationY>686</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Origin_Missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Priority_Medium</name>
        <label>Asg Priority Medium</label>
        <locationX>578</locationX>
        <locationY>686</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Origin_Missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Priority_Low</name>
        <label>Asg Priority Low</label>
        <locationX>842</locationX>
        <locationY>686</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dec_Origin_Missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asg_Default_Origin</name>
        <label>Asg Default Origin</label>
        <locationX>314</locationX>
        <locationY>1022</locationY>
        <assignmentItems>
            <assignToReference>$Record.Origin</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Dec_Has_Account</name>
        <label>Dec Has Account</label>
        <locationX>50</locationX>
        <locationY>182</locationY>
        <defaultConnector>
            <targetReference>Dec_Has_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Has_Contact</name>
        <label>Dec Has Contact</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Dec_Priority_Rule</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact</defaultConnectorLabel>
        <rules>
            <name>Has_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_Cases</targetReference>
            </connector>
            <label>Has Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Case_Is_Open</name>
        <label>Dec Case Is Open</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <defaultConnector>
            <targetReference>Loop_Contact_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Closed</defaultConnectorLabel>
        <rules>
            <name>Is_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Contact_Cases.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Increment_Open</targetReference>
            </connector>
            <label>Is Open</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Priority_Rule</name>
        <label>Dec Priority Rule</label>
        <locationX>578</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Asg_Priority_Low</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard</defaultConnectorLabel>
        <rules>
            <name>Critical_Customer</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varAccountRating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpenCaseCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Priority_High</targetReference>
            </connector>
            <label>Critical Customer</label>
        </rules>
        <rules>
            <name>Important_Customer</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Phone</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varAccountType</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Priority_Medium</targetReference>
            </connector>
            <label>Important Customer</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Origin_Missing</name>
        <label>Dec Origin Missing</label>
        <locationX>314</locationX>
        <locationY>854</locationY>
        <defaultConnectorLabel>Origin Set</defaultConnectorLabel>
        <rules>
            <name>Origin_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asg_Default_Origin</targetReference>
            </connector>
            <label>Origin Missing</label>
        </rules>
    </decisions>
    <description>Before-save (fast field update) on Case create: derives Priority from Account rating/type, the contact's open cases in the last 30 days and Origin; defaults Origin to Web.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxLast30Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <interviewLabel>RTF Case Before Save Triage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Case Before Save Triage</label>
    <loops>
        <name>Loop_Contact_Cases</name>
        <label>Loop Contact Cases</label>
        <locationX>50</locationX>
        <locationY>686</locationY>
        <collectionReference>Get_Contact_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Dec_Case_Is_Open</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Dec_Priority_Rule</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asg_Account_Context</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact_Cases</name>
        <label>Get Contact Cases</label>
        <locationX>314</locationX>
        <locationY>518</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Contact_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>fxLast30Days</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Dec_Has_Account</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varAccountRating</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAccountType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOpenCaseCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
